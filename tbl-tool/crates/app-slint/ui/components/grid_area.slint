// 表格区：固定表头 + 数据行 + 行号列。
// 对应 docs/02-UI设计.md §3 / @01.5.5。
//
// 注意：本组件只做布局/渲染骨架，真实编辑逻辑由 Rust 端通过回调接管。

import { Theme } from "../theme.slint";
import { ScrollView, LineEdit } from "std-widgets.slint";

// ── 单元格类型，对应 grid_model::CellKind ──
export enum CellKind {
    read-only,
    text,
    type-enum,
    export-enum,
    type-enum-col,
    export-enum-col,
    ref,
}

export struct HeaderCell {
    text: string,
    kind: CellKind,
    color: color,
}

export struct DataCell {
    text: string,           // 展示值（已经过 display_for_cell 转换）
    has-error: bool,
    is-empty-ref: bool,     // 引用为空 → 淡灰渲染
}

export struct DataRow {
    cells: [DataCell],
    row-color: color,       // 行背景色（用于 #@c: 标记）；transparent 表示默认
    selected: bool,
}

// 自制 Export 下拉：用普通 Rectangle 渲染（不用 PopupWindow，因 PopupWindow 不能在 for/if 内）。
// 由父级条件渲染控制可见性，dismiss TouchArea 见 GridArea 顶层。
component ExportDropdown inherits Rectangle {
    in property <int> current-index: 0;
    callback selected(int);
    width: Theme.col-w;
    height: Theme.row-h * 4;
    background: Theme.bg-panel;
    border-color: Theme.border;
    border-width: 1px;
    drop-shadow-blur: 6px;
    drop-shadow-color: #00000040;
    VerticalLayout {
        spacing: 0;
        for label[i] in ["前后端","客户端","服务器","不导出"]: Rectangle {
            height: Theme.row-h;
            background: hover-area.has-hover ? Theme.bg-row-selected
                : (i == root.current-index ? Theme.bg-cell-selected : Theme.bg-panel);
            Text {
                text: label;
                font-size: Theme.fs-small;
                color: Theme.text-primary;
                horizontal-alignment: left;
                vertical-alignment: center;
                x: 6px;
            }
            hover-area := TouchArea {
                clicked => { root.selected(i); }
            }
        }
    }
}

export component GridArea inherits Rectangle {
    in property <[[HeaderCell]]> header-rows;     // 多行表头（Table 4 行 / Constant 1 行 / Enum 1 行）
    in property <[DataRow]> data-rows;
    // 数据列的 kind（与 header.field 行对齐）。slint 侧靠它判断 cell 单击行为
    // （ExportEnumCol → 弹 popup；其它 → 仅选中）。
    in property <[CellKind]> column-kinds;
    in property <int> col-count: 0;
    in property <int> selected-col: -1;           // 整列选中（-1 = 无）
    in property <int> selected-row: -1;           // 整行选中
    in property <int> selected-cell-row: -1;
    in property <int> selected-cell-col: -1;
    // 矩形选区边界（含端）；-1 = 非区域选区。Rust 端按 GridSelection::CellRange 计算。
    in property <int> range-row-min: -1;
    in property <int> range-row-max: -1;
    in property <int> range-col-min: -1;
    in property <int> range-col-max: -1;
    in property <string> empty-hint: "选择左侧节点查看详情";
    // inline 编辑（数据格）：editing-row/col 命中时覆盖 LineEdit。-1 = 不编辑。
    in property <int> editing-row: -1;
    in property <int> editing-col: -1;
    // 表头编辑：editing-header-row + editing-header-col 命中时覆盖 LineEdit；-1 = 不编辑。
    // 与数据格 editing-row/col 互斥（同一时刻最多一个 LineEdit）。
    in property <int> editing-header-row: -1;
    in property <int> editing-header-col: -1;
    in-out property <string> editing-buffer: "";
    // 当前 cell / 表头 cell 的 export 当前索引（0..3）。Rust 端选中后 push 进来。
    in property <int> editing-export-index: 0;

    callback header-clicked(int /* hrow */, int /* col */);
    callback header-double-clicked(int /* hrow */, int /* col */);
    callback cell-clicked(int /* row */, int /* col */);
    callback cell-shift-clicked(int /* row */, int /* col */);
    // 鼠标左键按下（无 shift）：Rust 端立即重置选区为单格，作为后续拖选 anchor。
    callback cell-pressed(int /* row */, int /* col */);
    callback cell-double-clicked(int /* row */, int /* col */);
    /// 鼠标拖选：按下后拖动时持续触发。pi/cj = 起手 cell；mx/my = 相对该 cell 的鼠标偏移。
    /// Rust 端按 col-w / row-h 推算终点 cell。
    callback cell-drag(int /* anchor_row */, int /* anchor_col */, length /* mouse_x */, length /* mouse_y */);
    callback row-num-clicked(int);
    callback col-letter-clicked(int);
    callback col-context-menu(int, length, length);
    callback row-context-menu(int, length, length);
    callback cell-context-menu(int, int, length, length);
    callback cell-edit-committed();
    callback cell-edit-canceled();
    callback blank-clicked();
    callback cell-export-selected(int /* row */, int /* col */, int /* idx */);
    callback header-export-selected(int /* col */, int /* idx */);

    background: Theme.bg-panel;

    // popup 目标坐标：cell 模式 (export-target-row, export-target-col)；header 模式 export-target-is-header=true 时 export-target-row=hi。
    // 由 cell/header click 写入；用作 popup.selected 时分发回调。
    property <int> export-target-row: -1;
    property <int> export-target-col: -1;
    property <bool> export-target-is-header: false;
    property <length> export-popup-x: 0px;
    property <length> export-popup-y: 0px;
    property <bool> export-popup-open: false;

    // 字母列函数：A..Z（>26 暂不支持，显示 "?"）。
    // Slint 1.x 不支持 string 下标，因此用一长串三元展开。
    pure function col-letter(c: int) -> string {
        c == 0 ? "A" : c == 1 ? "B" : c == 2 ? "C" : c == 3 ? "D"
      : c == 4 ? "E" : c == 5 ? "F" : c == 6 ? "G" : c == 7 ? "H"
      : c == 8 ? "I" : c == 9 ? "J" : c == 10 ? "K" : c == 11 ? "L"
      : c == 12 ? "M" : c == 13 ? "N" : c == 14 ? "O" : c == 15 ? "P"
      : c == 16 ? "Q" : c == 17 ? "R" : c == 18 ? "S" : c == 19 ? "T"
      : c == 20 ? "U" : c == 21 ? "V" : c == 22 ? "W" : c == 23 ? "X"
      : c == 24 ? "Y" : c == 25 ? "Z" : "?"
    }

    // 空态：未选中任何节点 / 节点无字段
    if root.col-count == 0 || root.header-rows.length == 0: Rectangle {
        Text {
            text: root.empty-hint;
            font-size: Theme.fs-normal;
            color: Theme.text-disabled;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if root.col-count > 0 && root.header-rows.length > 0: VerticalLayout {
        spacing: 0;

        // ───── 固定表头 ─────
        Rectangle {
            height: Theme.row-h * (1 + root.header-rows.length);
            background: Theme.bg-header;

            VerticalLayout {
                spacing: 0;

                // 列字母行
                HorizontalLayout {
                    spacing: 0;
                    Rectangle {
                        width: Theme.row-num-w;
                        background: Theme.bg-header;
                        border-color: Theme.border;
                        border-width: 0.5px;
                    }
                    for c in root.col-count: Rectangle {
                        width: Theme.col-w;
                        height: Theme.row-h;
                        background: c == root.selected-col ? Theme.bg-cell-selected : Theme.bg-header;
                        border-color: Theme.border;
                        border-width: 0.5px;
                        Text {
                            text: root.col-letter(c);
                            font-size: Theme.fs-tiny;
                            color: Theme.text-secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => { root.col-letter-clicked(c); }
                            pointer-event(e) => {
                                if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                                    root.col-context-menu(c,
                                        self.absolute-position.x + self.mouse-x,
                                        self.absolute-position.y + self.mouse-y);
                                }
                            }
                        }
                    }
                }

                // 表头各行（desc/type/export/field）
                for hrow[hi] in root.header-rows: HorizontalLayout {
                    spacing: 0;
                    Rectangle {
                        width: Theme.row-num-w;
                        background: Theme.bg-header;
                        border-color: Theme.border;
                        border-width: 0.5px;
                    }
                    for cell[ci] in hrow: Rectangle {
                        property <bool> is-editing: hi == root.editing-header-row && ci == root.editing-header-col;
                        property <bool> is-export: cell.kind == CellKind.export-enum || cell.kind == CellKind.export-enum-col;
                        width: Theme.col-w;
                        height: Theme.row-h;
                        background: cell.kind == CellKind.read-only
                            ? Theme.bg-header-readonly
                            : (ci == root.selected-col ? Theme.bg-cell-selected : Theme.bg-header);
                        border-color: Theme.border;
                        border-width: 0.5px;
                        // 非编辑态：纯 Text（编辑态时不渲染）
                        if !is-editing: Text {
                            text: cell.text;
                            font-size: Theme.fs-tiny;
                            color: cell.kind == CellKind.read-only ? Theme.text-readonly : cell.color;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        // 下拉箭头（type/export 类）
                        if !is-editing && (cell.kind == CellKind.type-enum
                          || cell.kind == CellKind.export-enum
                          || cell.kind == CellKind.type-enum-col
                          || cell.kind == CellKind.export-enum-col): Text {
                            x: parent.width - 12px;
                            text: "▼";
                            font-size: 8px;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                        }
                        // 编辑态：表头 desc / field 等 Text 类——LineEdit 占满 cell
                        if is-editing: LineEdit {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            text <=> root.editing-buffer;
                            init => {
                                self.focus();
                                self.select-all();
                            }
                            accepted(s) => { root.cell-edit-committed(); }
                        }
                        // 普通可编辑（非 Export）的 TouchArea：单击选中 / 双击编辑
                        if cell.kind != CellKind.read-only && !is-editing && !is-export: TouchArea {
                            clicked => { root.header-clicked(hi, ci); }
                            double-clicked => { root.header-double-clicked(hi, ci); }
                        }
                        // Export 单元格：先设 popup 状态（保证 TouchArea 销毁前 root 状态写完），再调 root callback
                        if is-export && !is-editing: TouchArea {
                            clicked => {
                                root.export-target-is-header = true;
                                root.export-target-row = hi;
                                root.export-target-col = ci;
                                root.export-popup-x = self.absolute-position.x - root.absolute-position.x;
                                root.export-popup-y = self.absolute-position.y - root.absolute-position.y + parent.height;
                                root.export-popup-open = true;
                                root.header-clicked(hi, ci);  // 让 Rust 同步 editing-export-index（最后调，避免 TouchArea 因 push_grid 销毁后丢状态）
                            }
                        }
                    }
                }
            }
        }

        // ───── 数据区（可滚动）─────
        ScrollView {
            // 背景兜底 TouchArea：点击数据区空白处 → blank-clicked（用于 Excel 风格 commit）
            // 在 cell 之前声明，cell 的 TouchArea 会盖住它，只有点到空白才触发
            TouchArea {
                clicked => { root.blank-clicked(); }
            }
            VerticalLayout {
                spacing: 0;
                for row[ri] in root.data-rows: HorizontalLayout {
                    spacing: 0;
                    // 行号
                    Rectangle {
                        width: Theme.row-num-w;
                        height: Theme.row-h;
                        background: ri == root.selected-row ? Theme.bg-row-selected : Theme.bg-header;
                        border-color: Theme.border;
                        border-width: 0.5px;
                        Text {
                            text: ri + 1;
                            font-size: Theme.fs-tiny;
                            color: Theme.text-secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => { root.row-num-clicked(ri); }
                            pointer-event(e) => {
                                if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                                    root.row-context-menu(ri,
                                        self.absolute-position.x + self.mouse-x,
                                        self.absolute-position.y + self.mouse-y);
                                }
                            }
                        }
                    }
                    for cell[ci] in row.cells: Rectangle {
                        property <bool> is-editing: ri == root.editing-row && ci == root.editing-col;
                        property <CellKind> col-kind: ci < root.column-kinds.length ? root.column-kinds[ci] : CellKind.text;
                        property <bool> is-export: col-kind == CellKind.export-enum-col || col-kind == CellKind.export-enum;
                        property <bool> in-range: root.range-row-min >= 0
                            && ri >= root.range-row-min && ri <= root.range-row-max
                            && ci >= root.range-col-min && ci <= root.range-col-max;
                        width: Theme.col-w;
                        height: Theme.row-h;
                        background:
                            (ri == root.selected-cell-row && ci == root.selected-cell-col) ? Theme.bg-cell-selected
                            : in-range ? Theme.bg-row-selected
                            : (ri == root.selected-row || ci == root.selected-col) ? Theme.bg-row-selected
                            : (row.row-color.alpha > 0 ? row.row-color : (mod(ri, 2) == 0 ? Theme.bg-panel : Theme.bg-row-alt));
                        border-color: cell.has-error ? Theme.border-error : Theme.border-light;
                        border-width: cell.has-error ? 1.5px : 0.5px;
                        // 非编辑态显示文字
                        if !is-editing: Text {
                            text: cell.text;
                            font-size: Theme.fs-small;
                            color: cell.is-empty-ref ? Theme.text-disabled : Theme.text-primary;
                            horizontal-alignment: left;
                            vertical-alignment: center;
                            x: 4px;
                        }
                        // 下拉箭头（ExportEnumCol / TypeEnumCol / Ref 列）
                        if !is-editing && (is-export
                          || col-kind == CellKind.type-enum-col
                          || col-kind == CellKind.type-enum
                          || col-kind == CellKind.ref): Text {
                            x: parent.width - 12px;
                            text: "▼";
                            font-size: 8px;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                        }
                        // 普通 cell（非 Export）：单 TouchArea 处理 click / 双击 / 右键 / 拖选
                        if !is-editing && !is-export: TouchArea {
                            // 记录最近一次按下时的 shift 修饰键状态；clicked 时分发 shift-clicked
                            // vs cell-clicked。slint 的 clicked 信号不暴露 modifiers，故用 pointer-event 兜底。
                            property <bool> last-shift: false;
                            // 记录从按下后是否产生过位移（dr/dc 任一非零）。仅在产生位移时通知 Rust 扩选区，
                            // 避免单击释放前的微小抖动把单格强制扩成 CellRange。
                            property <bool> dragged: false;
                            clicked => {
                                if (self.last-shift) { root.cell-shift-clicked(ri, ci); }
                                else { root.cell-clicked(ri, ci); }
                            }
                            double-clicked => { root.cell-double-clicked(ri, ci); }
                            // 按下后拖动：持续把鼠标位置发给 Rust，Rust 推算终点 cell 并扩 GridSelection
                            moved => {
                                self.dragged = true;
                                root.cell-drag(ri, ci, self.mouse-x, self.mouse-y);
                            }
                            pointer-event(e) => {
                                if e.kind == PointerEventKind.down {
                                    self.last-shift = e.modifiers.shift;
                                    self.dragged = false;
                                    // 左键按下立刻通知 Rust 重置 anchor 到本 cell，旧选区清掉。
                                    // shift+down 不重置（让 shift+click 能从旧 anchor 扩展）。
                                    if e.button == PointerEventButton.left && !e.modifiers.shift {
                                        root.cell-pressed(ri, ci);
                                    }
                                }
                                if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                                    root.cell-context-menu(ri, ci,
                                        self.absolute-position.x + self.mouse-x,
                                        self.absolute-position.y + self.mouse-y);
                                }
                            }
                        }
                        // ExportEnumCol cell：先设 popup 状态再调 root callback
                        if !is-editing && is-export: TouchArea {
                            clicked => {
                                root.export-target-is-header = false;
                                root.export-target-row = ri;
                                root.export-target-col = ci;
                                root.export-popup-x = self.absolute-position.x - root.absolute-position.x;
                                root.export-popup-y = self.absolute-position.y - root.absolute-position.y + parent.height;
                                root.export-popup-open = true;
                                root.cell-clicked(ri, ci);
                            }
                            pointer-event(e) => {
                                if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                                    root.cell-context-menu(ri, ci,
                                        self.absolute-position.x + self.mouse-x,
                                        self.absolute-position.y + self.mouse-y);
                                }
                            }
                        }
                        // 编辑态：LineEdit 占满 cell
                        // 失焦 commit 不通过 changed has-focus（实测重入崩溃），
                        // 由 Rust 在 cell-clicked / 切节点 等场景主动 commit
                        if is-editing: LineEdit {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            text <=> root.editing-buffer;
                            init => {
                                self.focus();
                                self.select-all();
                            }
                            accepted(s) => { root.cell-edit-committed(); }
                        }
                    }
                }
            }
        }
    }

    // ── Export Popup overlay（条件渲染）──
    // 用 Rectangle + 全屏 dismiss TouchArea 模拟 PopupWindow，避免 PopupWindow 在 for/if 内的限制。
    // 点击外部 dismiss-area 关闭；点击列表项 selected 关闭。
    if root.export-popup-open: Rectangle {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        // 全屏 dismiss 区域（位于下拉之下）
        TouchArea {
            clicked => { root.export-popup-open = false; }
        }
        ExportDropdown {
            x: root.export-popup-x;
            y: root.export-popup-y;
            current-index: root.editing-export-index;
            selected(idx) => {
                if (root.export-target-is-header) {
                    root.header-export-selected(root.export-target-col, idx);
                } else {
                    root.cell-export-selected(root.export-target-row, root.export-target-col, idx);
                }
                root.export-popup-open = false;
            }
        }
    }
}

// 单文件预览：一个示例 Table（含 ReadOnly id 列 + 中文 desc + 类型 + 数据）
export component GridAreaPreview inherits Window {
    title: "GridArea Preview";
    width: 720px;
    height: 360px;

    GridArea {
        col-count: 5;
        selected-cell-row: 1;
        selected-cell-col: 1;
        header-rows: [
            // desc
            [
                { text: "英雄ID", kind: CellKind.read-only, color: Theme.text-readonly },
                { text: "名称", kind: CellKind.text, color: Theme.text-primary },
                { text: "血量", kind: CellKind.text, color: Theme.text-primary },
                { text: "类型", kind: CellKind.text, color: Theme.text-primary },
                { text: "技能组", kind: CellKind.text, color: Theme.text-primary },
            ],
            // export
            [
                { text: "cs", kind: CellKind.read-only, color: Theme.text-readonly },
                { text: "前后端", kind: CellKind.export-enum, color: Theme.text-success },
                { text: "服务器", kind: CellKind.export-enum, color: Theme.text-success },
                { text: "前后端", kind: CellKind.export-enum, color: Theme.text-success },
                { text: "前后端", kind: CellKind.export-enum, color: Theme.text-success },
            ],
            // type
            [
                { text: "int", kind: CellKind.read-only, color: Theme.text-readonly },
                { text: "str", kind: CellKind.type-enum, color: Theme.text-info },
                { text: "int", kind: CellKind.type-enum, color: Theme.text-info },
                { text: "@HeroType", kind: CellKind.type-enum, color: Theme.text-info },
                { text: "List<int>", kind: CellKind.type-enum, color: Theme.text-info },
            ],
            // field
            [
                { text: "id", kind: CellKind.read-only, color: Theme.text-readonly },
                { text: "name", kind: CellKind.text, color: Theme.text-primary },
                { text: "hp", kind: CellKind.text, color: Theme.text-primary },
                { text: "type", kind: CellKind.text, color: Theme.text-primary },
                { text: "skills", kind: CellKind.text, color: Theme.text-primary },
            ],
        ];
        data-rows: [
            { cells: [
                { text: "1001", has-error: false, is-empty-ref: false },
                { text: "战士", has-error: false, is-empty-ref: false },
                { text: "100", has-error: false, is-empty-ref: false },
                { text: "WARRIOR", has-error: false, is-empty-ref: false },
                { text: "1;2;3", has-error: false, is-empty-ref: false },
            ], row-color: #00000000, selected: false },
            { cells: [
                { text: "1002", has-error: false, is-empty-ref: false },
                { text: "法师", has-error: false, is-empty-ref: false },
                { text: "80", has-error: false, is-empty-ref: false },
                { text: "MAGE", has-error: false, is-empty-ref: false },
                { text: "4;5", has-error: false, is-empty-ref: false },
            ], row-color: #00000000, selected: true },
            { cells: [
                { text: "1003", has-error: false, is-empty-ref: false },
                { text: "弓手", has-error: false, is-empty-ref: false },
                { text: "abc", has-error: true, is-empty-ref: false },
                { text: "", has-error: false, is-empty-ref: true },
                { text: "6;7;8", has-error: false, is-empty-ref: false },
            ], row-color: #ffe0e0, selected: false },
        ];
    }
}
