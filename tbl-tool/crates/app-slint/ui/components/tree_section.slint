// 配置树大区（TreeSection）：左侧主区域，聚合标题 + 功能区 + 节点列表。
// 子区域顺序（从上到下）：
//   1. 标题栏        ─ "配置树"
//   2. 功能区        ─ 搜索 / 过滤 / 完整组
//   3. 节点展示区    ─ 树列表（vertical-stretch）
//
// 对应 docs/02-UI设计.md §2。

import { Theme } from "../theme.slint";
import { Button, ComboBox, CheckBox, LineEdit, ScrollView } from "std-widgets.slint";

export struct TreeNode {
    id: int,                // 唯一 id（行号）
    indent: int,            // 缩进层级（0=组、1=配置项）
    expanded: bool,         // 仅组节点有意义
    icon: string,           // 📁/📊/📋/🔢
    name: string,
    mark: string,           // ""/"+"/"*"/"-"/"!"
    mark-color: color,
    is-group: bool,
    selected: bool,
    /// closed project 渲染为灰态：无展开三角，名称变浅，不参与搜索
    closed: bool,
}

export component TreeSection inherits Rectangle {
    in property <[TreeNode]> nodes;
    in property <[string]> filters: ["全部", "改动", "新增", "修改", "删除"];
    in property <int> filter-index: 0;
    in-out property <bool> full-group: false;
    in-out property <string> search: "";
    in property <[string]> sort-options: ["ID", "名称", "已打开", "创建时间", "手动"];
    in property <int> sort-index: 0;

    callback node-clicked(int);
    callback node-double-clicked(int);
    callback node-toggle-expand(int);
    callback node-context-menu(int, length, length);
    callback blank-context-menu(length, length);
    callback blank-clicked();
    callback filter-changed(int);
    callback search-edited(string);
    callback full-group-toggled(bool);
    callback new-project-clicked();
    callback sort-changed(int);

    background: Theme.bg-panel;
    border-color: Theme.border-light;
    border-width: 1px;

    VerticalLayout {
        spacing: 0;
        padding: 0;

        // ─── 1. 标题栏 ───
        Rectangle {
            height: 24px;
            background: Theme.bg-toolbar;
            border-color: Theme.border-light;
            border-width: 1px;
            Text {
                x: Theme.sp-3;
                text: "项目列表";
                font-size: Theme.fs-small;
                color: Theme.text-primary;
                vertical-alignment: center;
            }
        }

        // ─── 2. 顶部功能区：新建项目 + 排序下拉 ───
        Rectangle {
            height: top-stack.preferred-height;
            background: Theme.bg-toolbar;
            border-color: Theme.border-light;
            border-width: 1px;
            top-stack := HorizontalLayout {
                padding: Theme.sp-3;
                spacing: Theme.sp-2;
                alignment: stretch;
                Button {
                    text: "新建项目";
                    clicked => { root.new-project-clicked(); }
                }
                ComboBox {
                    model: root.sort-options;
                    current-index: root.sort-index;
                    selected(s) => { root.sort-changed(self.current-index); }
                }
            }
        }

        // ─── 3. 搜索 / 过滤 / 完整组 ───
        Rectangle {
            height: filter-stack.preferred-height;
            background: Theme.bg-toolbar;
            border-color: Theme.border-light;
            border-width: 1px;
            filter-stack := VerticalLayout {
                padding: Theme.sp-3;
                spacing: Theme.sp-2;

                // 搜索框
                HorizontalLayout {
                    spacing: Theme.sp-2;
                    alignment: stretch;
                    Text {
                        text: "搜索:";
                        font-size: Theme.fs-tiny;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                        width: 32px;
                    }
                    LineEdit {
                        text <=> root.search;
                        placeholder-text: "名称 / 拼音首字母";
                        edited(s) => { root.search-edited(s); }
                    }
                }
                // 过滤下拉
                HorizontalLayout {
                    spacing: Theme.sp-2;
                    alignment: stretch;
                    Text {
                        text: "过滤:";
                        font-size: Theme.fs-tiny;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                        width: 32px;
                    }
                    ComboBox {
                        model: root.filters;
                        current-index: root.filter-index;
                        selected(s) => { root.filter-changed(self.current-index); }
                    }
                }
                // 完整组勾选
                CheckBox {
                    text: "完整组";
                    checked <=> root.full-group;
                    toggled => { root.full-group-toggled(self.checked); }
                }
            }
        }

        // ─── 4. 节点展示区（ScrollView 满铺；底层 TouchArea 接管空白区右键 / 失焦点击）───
        Rectangle {
            vertical-stretch: 1;

            // 底层：空白区右键 + 左键失焦。被节点行级 TouchArea 覆盖的区域不会命中这里。
            TouchArea {
                clicked => { root.blank-clicked(); }
                pointer-event(e) => {
                    if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                        root.blank-context-menu(
                            self.absolute-position.x + self.mouse-x,
                            self.absolute-position.y + self.mouse-y);
                    }
                }
            }

            ScrollView {
                VerticalLayout {
                    padding: 0;
                    spacing: 0;
                    for node in root.nodes: Rectangle {
                        height: Theme.row-h;
                        background: node.selected ? Theme.bg-row-selected : transparent;

                        // 行级 TouchArea：包住整行；triangle TouchArea 作为嵌套子级优先 dispatch（slint 的内层 TouchArea 先于外层吃事件）
                        TouchArea {
                            clicked => { root.node-clicked(node.id); }
                            double-clicked => { root.node-double-clicked(node.id); }
                            pointer-event(e) => {
                                if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                                    root.node-context-menu(node.id,
                                        self.absolute-position.x + self.mouse-x,
                                        self.absolute-position.y + self.mouse-y);
                                }
                            }

                            HorizontalLayout {
                                padding-left: 4px + node.indent * 14px;
                                padding-right: Theme.sp-2;
                                spacing: Theme.sp-2;
                                alignment: start;

                                // 展开三角（仅组节点）；嵌套 TouchArea 比父 TouchArea 优先吃事件
                                if node.is-group: Rectangle {
                                    width: 12px;
                                    TouchArea {
                                        clicked => { root.node-toggle-expand(node.id); }
                                        Text {
                                            text: node.expanded ? "▼" : "▶";
                                            font-size: 9px;
                                            color: Theme.text-secondary;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                if !node.is-group: Rectangle { width: 12px; }

                                Text {
                                    text: node.icon;
                                    font-size: Theme.fs-small;
                                    vertical-alignment: center;
                                    opacity: node.closed ? 0.5 : 1.0;
                                }
                                Text {
                                    text: node.name;
                                    font-size: Theme.fs-small;
                                    color: node.closed ? Theme.text-secondary : Theme.text-primary;
                                    vertical-alignment: center;
                                    opacity: node.closed ? 0.7 : 1.0;
                                }
                                if node.mark != "": Text {
                                    text: node.mark;
                                    font-size: Theme.fs-small;
                                    color: node.mark-color;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component TreeSectionPreview inherits Window {
    title: "TreeSection Preview";
    width: 240px;
    height: 480px;

    TreeSection {
        nodes: [
            { id: 1, indent: 0, expanded: true, icon: "📦", name: "demo-game", mark: "", mark-color: Theme.text-primary, is-group: true, selected: false, closed: false },
            { id: 2, indent: 1, expanded: true, icon: "📁", name: "hero", mark: "*", mark-color: Theme.mark-modified, is-group: true, selected: false, closed: false },
            { id: 3, indent: 2, expanded: false, icon: "📊", name: "HeroBase", mark: "*", mark-color: Theme.mark-modified, is-group: false, selected: true, closed: false },
            { id: 4, indent: 0, expanded: false, icon: "📦", name: "another-project", mark: "", mark-color: Theme.text-primary, is-group: true, selected: false, closed: true },
        ];
    }
}
