// 顶部工具栏：单行主按钮区。
// 表级开关（如「枚举显示名字」）已下移至右侧表格面板的功能区 bar。
// 对应 docs/02-UI设计.md §5.1。

import { Theme } from "../theme.slint";
import { Button } from "std-widgets.slint";

export component Toolbar inherits Rectangle {
    callback btn-clicked(string);          // 按钮 id：generate-test/clear/excel/save/reload/export/export-schema/import-schema

    height: Theme.toolbar-h;
    background: Theme.bg-toolbar;
    border-color: Theme.border-light;
    border-width: 1px;

    HorizontalLayout {
        padding-left: Theme.sp-3;
        padding-right: Theme.sp-3;
        padding-top: Theme.sp-2;
        padding-bottom: Theme.sp-2;
        spacing: Theme.sp-2;
        alignment: start;

        // S15-X 待重新评估 —— 暂时注释掉「生成测试数据」/「清空配置」
        // Button { text: "生成测试数据"; clicked => { root.btn-clicked("generate-test"); } }
        // Button { text: "清空配置"; clicked => { root.btn-clicked("clear"); } }
        // Rectangle { width: 1px; background: Theme.border-light; }
        Button { text: "用 Excel 打开"; clicked => { root.btn-clicked("excel"); } }
        Button { text: "保存"; clicked => { root.btn-clicked("save"); } }
        Button { text: "重新加载"; clicked => { root.btn-clicked("reload"); } }
        Rectangle { width: 1px; background: Theme.border-light; }
        Button { text: "导出"; clicked => { root.btn-clicked("export"); } }
        Button { text: "导出 Schema"; clicked => { root.btn-clicked("export-schema"); } }
        Button { text: "导入 Schema"; clicked => { root.btn-clicked("import-schema"); } }
        // 模板库按钮已挪到 TreeSection 顶部功能区（在搜索框上方）。
    }
}

export component ToolbarPreview inherits Window {
    title: "Toolbar Preview";
    width: 900px;
    height: 60px;

    Toolbar { }
}
