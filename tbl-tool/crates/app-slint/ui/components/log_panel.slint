// 日志面板：全窗口底部独立区域，带「日志」标题。
// 对应 docs/02-UI设计.md §1.1。
//
// 实现：把所有日志合成单个多行字符串，渲染为 read-only 多行 TextInput，
// 这样用户可以跨行选中 + Ctrl+C 复制（egui 端用 ScrollArea + 多行 SelectableLabel 实现，
// 在 slint 里用单 TextInput 更简单）。
// 颜色 tint 因此从"按 level"退化为"统一颜色"——错误信息从 `[验证]/失败/错误` 前缀辨识。

import { Theme } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";

export struct LogEntry {
    time: string,           // "14:32:01"
    msg: string,
    level: int,             // 0=info, 1=warn, 2=error
}

export component LogPanel inherits Rectangle {
    // logs：仍保留旧 struct 列表，方便 Rust 端不改 push_logs 调用方式
    in property <[LogEntry]> logs;
    // text-flat：拼接好的多行字符串。Rust 端直接 set_logs_text 传入。
    in property <string> text-flat: "";
    in property <length> log-height: 120px;

    height: root.log-height;
    background: Theme.bg-panel;
    border-color: Theme.border-light;
    border-width: 1px;

    VerticalLayout {
        spacing: 0;
        Rectangle {
            height: 22px;
            background: Theme.bg-toolbar;
            border-color: Theme.border-light;
            border-width: 1px;
            Text {
                x: Theme.sp-3;
                text: "日志";
                font-size: Theme.fs-small;
                color: Theme.text-primary;
                vertical-alignment: center;
            }
        }
        ScrollView {
            VerticalLayout {
                padding: Theme.sp-2;
                spacing: 0;
                // 整个日志一个多行 read-only TextInput：可跨行选中 + Ctrl+C 复制
                TextInput {
                    text: root.text-flat;
                    read-only: true;
                    single-line: false;
                    wrap: word-wrap;
                    font-size: Theme.fs-tiny;
                    color: Theme.text-secondary;
                }
            }
        }
    }
}

export component LogPanelPreview inherits Window {
    title: "LogPanel Preview";
    width: 720px;
    height: 200px;

    LogPanel {
        text-flat: "14:32:01 已加载 hero/HeroBase.tbl (3条)\n14:33:15 新建 Table: hero/HeroSkill\n14:34:02 [验证] hero/HeroBase D2: 列表元素类型不匹配";
    }
}
