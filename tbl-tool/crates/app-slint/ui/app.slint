    }

    // ContextMenu 必须放在最顶层（z 在所有 dialog 之上），点击 item 触发 ctx-menu-action
    ContextMenu {
        open: root.ctx-menu-open;
        menu-x: root.ctx-menu-x;
        menu-y: root.ctx-menu-y;
        items: root.ctx-menu-items;
        action(id) => { root.ctx-menu-action(id); }
        dismiss => { root.ctx-menu-dismiss(); }
    }
}

