        sep-ml-entry <=> root.ps-sep-ml-entry;
        tab-changed(i) => { root.ps-tab = i; root.ps-tab-changed(i); }
        id-edited(s) => { root.ps-id-edited(s); }
        name-edited(s) => { root.ps-name-edited(s); }
        category-edited(s) => { root.ps-category-edited(s); }
        version-edited(s) => { root.ps-version-edited(s); }
