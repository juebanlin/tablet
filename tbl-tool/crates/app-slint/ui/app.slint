        name-edited(s) => { root.np-name-edited(s); }
        category-edited(s) => { root.np-category-edited(s); }
        version-edited(s) => { root.np-version-edited(s); }
        confirm => { root.np-confirm(); }
        cancel => { root.np-cancel(); root.dlg-new-project-open = false; }
    }

    ProjectSettingsDialog {
        open: root.dlg-ps-open;
        tab: root.ps-tab;
        id-buf <=> root.ps-id-buf;
        name-buf <=> root.ps-name-buf;
        category-buf <=> root.ps-category-buf;
        version-buf <=> root.ps-version-buf;
        id-error: root.ps-id-error;
        can-confirm: root.ps-can-confirm;
        sep-tuple2 <=> root.ps-sep-tuple2;
        sep-tuple3 <=> root.ps-sep-tuple3;
        sep-tuple4 <=> root.ps-sep-tuple4;
        sep-list <=> root.ps-sep-list;
        sep-set <=> root.ps-sep-set;
        sep-map-kv <=> root.ps-sep-map-kv;
        sep-map-entry <=> root.ps-sep-map-entry;
        sep-lt2-tuple <=> root.ps-sep-lt2-tuple;
        sep-lt2-list <=> root.ps-sep-lt2-list;
        sep-lt3-tuple <=> root.ps-sep-lt3-tuple;
        sep-lt3-list <=> root.ps-sep-lt3-list;
        sep-lt4-tuple <=> root.ps-sep-lt4-tuple;
        sep-lt4-list <=> root.ps-sep-lt4-list;
        sep-mt2-kv <=> root.ps-sep-mt2-kv;
