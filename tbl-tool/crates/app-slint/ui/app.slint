// 主窗口：聚合三大顶层区域 + 弹窗 overlay。
// 对应 docs/02-UI设计.md §1.1。
//
// 顶层区域（z-order 自下而上）：
//   1. Toolbar       ─ 顶部全局工具栏
//   2. TreeSection   ─ 左侧配置树大区（标题 / 功能区 / 节点展示）
//      GridSection   ─ 右侧表格大区（标题 / 功能bar / 公式栏 / 表格 / 状态栏）
//   3. LogPanel      ─ 底部日志面板
//   4. Dialogs       ─ 模态弹窗 overlay（自带 scrim）
//
// 命名约定：
//   - 大区组件以 *Section 命名
//   - 子区域条以 *Bar / *Panel 命名
//   - 弹窗状态以 dlg-<name>-open 暴露给上层 Rust

import { Theme } from "theme.slint";
import { Toolbar } from "components/toolbar.slint";
import { TreeSection, TreeNode } from "components/tree_section.slint";
import { GridSection } from "components/grid_section.slint";
import { GridArea, HeaderCell, DataCell, DataRow, CellKind } from "components/grid_area.slint";
import { LogPanel, LogEntry } from "components/log_panel.slint";
import { TypeSelector, RefItem, TsParamSlot } from "dialogs/type_selector.slint";
import { RefPicker, RefRow, RefHeader } from "dialogs/ref_picker.slint";
import { ExportDialog } from "dialogs/export_dialog.slint";
import { SchemaExportDialog, SchemaImportDialog, SchemaItem } from "dialogs/schema_dialog.slint";
import { NewProjectDialog, TemplateItem } from "dialogs/template_dialog.slint";
import { CreateProjectDialog } from "dialogs/create_project.slint";
import { ContextMenu, CtxMenuItem } from "dialogs/context_menu.slint";
import { ProjectSettingsDialog } from "dialogs/project_settings.slint";
import { InputDialog } from "dialogs/input_dialog.slint";
import { ConfirmDialog } from "dialogs/confirm_dialog.slint";

export { TreeNode, HeaderCell, DataCell, DataRow, CellKind, LogEntry, RefItem, TsParamSlot, RefRow, RefHeader, SchemaItem, CtxMenuItem, TemplateItem }

export component AppWindow inherits Window {
    title: "tbl-tool · juebanlin@gmail.com";
    width: 1280px;
    height: 800px;
    background: Theme.bg-window;
    // Windows 默认 Segoe UI fallback 链对部分 CJK 字符（如 U+FF09 全角右括号）会
    // 命中无字形的字体导致豆腐框；显式指定 Microsoft YaHei UI 强制走系统中文字体。
    // macOS / Linux 找不到这个名字会回退到平台默认（PingFang SC / Noto Sans CJK）。
    default-font-family: "Microsoft YaHei UI";

    // ── Toolbar ─────────────────────────────────────────────
    callback toolbar-btn-clicked(string);

    // ── TreeSection ─────────────────────────────────────────
    in property <[TreeNode]> tree-nodes;
    in property <[string]> tree-filters: ["全部", "改动", "新增", "修改", "删除"];
    in-out property <int> tree-filter-index: 0;
    in-out property <bool> tree-full-group: false;
    in-out property <string> tree-search: "";
    in property <[string]> tree-sort-options: ["ID", "名称", "已打开", "创建时间", "手动"];
    in-out property <int> tree-sort-index: 0;
    callback tree-node-clicked(int);
    callback tree-node-double-clicked(int);
    callback tree-node-toggle-expand(int);
    callback tree-node-context-menu(int, length, length);
    callback tree-blank-context-menu(length, length);
    callback tree-search-edited(string);
    callback tree-filter-changed(int);
    callback tree-full-group-toggled(bool);
    callback tree-sort-changed(int);

    // ── GridSection ─────────────────────────────────────────
    in property <string> grid-title: "未选中";
    in property <string> grid-subtitle: "";
    in-out property <bool> show-enum-name: false;
    in property <bool> show-enum-name-enabled: false;
    in property <bool> excel-edit-enabled: false;
    callback show-enum-name-toggled(bool);
    callback excel-edit-clicked();

    in property <string> coord;
    in property <string> formula-display: "";
    in property <bool> formula-editable: false;
    in-out property <string> editing-buffer: "";
    in property <bool> formula-editing: false;
    callback formula-request-edit();
    callback formula-commit();
    callback formula-cancel();

    in property <[[HeaderCell]]> grid-header-rows;
    in property <[DataRow]> grid-data-rows;
    in property <[CellKind]> grid-column-kinds;
    in property <int> grid-col-count;
    in property <int> grid-selected-col: -1;
    in property <int> grid-selected-row: -1;
    in property <int> grid-selected-cell-row: -1;
    in property <int> grid-selected-cell-col: -1;
    in property <int> grid-range-row-min: -1;
    in property <int> grid-range-row-max: -1;
    in property <int> grid-range-col-min: -1;
    in property <int> grid-range-col-max: -1;
    in property <int> grid-editing-row: -1;
    in property <int> grid-editing-col: -1;
    in property <int> grid-editing-header-row: -1;
    in property <int> grid-editing-header-col: -1;
    in property <int> grid-editing-export-index: 0;
    // picker 类单元格呼出方式：true = 单击呼出，false = 双击呼出（来自 [ui] 配置）
    in property <bool> picker-trigger-header-single: false;
    in property <bool> picker-trigger-data-single: false;
    callback grid-header-clicked(int, int);
    callback grid-header-double-clicked(int, int);
    callback grid-cell-clicked(int, int);
    callback grid-cell-shift-clicked(int, int);
    callback grid-cell-pressed(int, int);
    callback grid-cell-double-clicked(int, int);
    callback grid-cell-drag(int, int, length, length);
    callback grid-row-num-clicked(int);
    callback grid-col-letter-clicked(int);
    callback grid-col-context-menu(int, length, length);
    callback grid-row-context-menu(int, length, length);
    callback grid-cell-context-menu(int, int, length, length);
    callback grid-cell-edit-committed();
    callback grid-cell-edit-canceled();
    callback grid-blank-clicked();
    callback grid-cell-export-selected(int, int, int);
    callback grid-header-export-selected(int, int);

    in property <string> selection-info;
    in property <string> hover-info;

    // ── LogPanel ────────────────────────────────────────────
    in property <[LogEntry]> logs;
    in property <string> logs-text;

    // ── Dialog: TypeSelector ────────────────────────────────
    in-out property <bool> dlg-type-open: false;
    in-out property <int> ts-tab: 0;
    in property <bool> ts-ref-disabled: false;
    in property <[string]> ts-paradigms;
    in-out property <int> ts-paradigm-index: 0;
    in property <[TsParamSlot]> ts-param-slots;
    in property <string> ts-result-preview;
    in property <string> ts-example-value;
    in property <string> ts-java-decl;
    in property <string> ts-go-decl;
    in property <string> ts-lua-decl;
    in-out property <string> ts-ref-search;
    in property <[RefItem]> ts-ref-items;
    in-out property <int> ts-ref-filter: 0;
    callback ts-set-tab(int);
    callback ts-set-paradigm(int);
    callback ts-set-param(int, int);
    callback ts-set-ref-search(string);
    callback ts-set-ref-filter(int);
    callback ts-select-ref(int);
    callback ts-confirm();
    callback ts-cancel();

    // ── Dialog: RefPicker ───────────────────────────────────
    in-out property <bool> dlg-ref-open: false;
    in property <string> rp-ref-name;
    in property <string> rp-kind-label: "📊 表引用";
    in property <bool> rp-target-missing: false;
    in property <bool> rp-is-table: true;
    in-out property <int> rp-strategy-index: 0;
    in property <RefHeader> rp-id-header: { field: "id", desc: "" };
    in property <[RefHeader]> rp-headers;
    in property <bool> rp-has-desc: false;
    in-out property <string> rp-search;
    in-out property <string> rp-manual-value;
    in property <[RefRow]> rp-rows;
    in property <string> rp-selection-preview: "（未选择）";
    callback rp-select-row(int);
    callback rp-row-double-clicked(int);
    callback rp-confirm();
    callback rp-clear();
    callback rp-cancel();
    callback rp-search-edited(string);
    callback rp-strategy-changed(int);
    callback rp-manual-edited(string);

    // ── Dialog: 数据导出 ────────────────────────────────────
    in-out property <bool> dlg-export-open: false;
    in-out property <bool> ex-json: true;
    in-out property <bool> ex-xml: true;
    in-out property <bool> ex-java: true;
    in-out property <bool> ex-go: false;
    in-out property <bool> ex-lua: true;
    callback ex-confirm();
    callback ex-cancel();

    // ── Dialog: Schema 导出 ─────────────────────────────────
    in-out property <bool> dlg-schema-export-open: false;
    in property <[SchemaItem]> sx-items;
    in-out property <bool> sx-all-checked: false;
    in property <int> sx-selected-count: 0;
    in property <int> sx-total-count: 0;
    /// 是否把当前数据作为 # @preset 块写进导出文件
    in-out property <bool> sx-with-preset: false;
    callback sx-toggle-all(bool);
    callback sx-toggle-item(int);
    callback sx-confirm();
    callback sx-cancel();

    // ── Dialog: Schema 导入 ─────────────────────────────────
    in-out property <bool> dlg-schema-import-open: false;
    in-out property <string> si-file-path;
    in property <bool> si-file-loaded: false;
    in property <[SchemaItem]> si-items;
    in-out property <bool> si-all-checked: false;
    in property <int> si-selected-count: 0;
    in property <int> si-total-count: 0;
    in property <int> si-conflict-count: 0;
    /// schema 是否带 `# @preset` 块（控制 with-preset 复选框可见性）
    in property <bool> si-has-preset: false;
    /// with-preset 勾选状态（true = 把 schema preset 一并灌进项目）
    in-out property <bool> si-with-preset: true;
    callback si-browse-file();
    callback si-toggle-all(bool);
    callback si-toggle-item(int);
    callback si-confirm();

    // ── Dialog: 新建项目（统一 3 tab：空 / 文件 / 模板）──────
    in-out property <bool> dlg-create-project-open: false;
    in property <int> cp-tab-index: 0;
    in-out property <string> cp-project-id;
    in-out property <string> cp-project-name;
    in-out property <string> cp-project-category;
    in-out property <string> cp-project-version;
    in-out property <bool> cp-open-after: true;
    in property <string> cp-id-error;
    in property <string> cp-name-error;
    in property <bool> cp-can-confirm: false;
    in property <bool> cp-source-has-preset: false;
    in-out property <bool> cp-with-preset: false;
    // FromFile tab
    in-out property <string> cp-file-path;
    in property <bool> cp-file-loaded: false;
    in property <string> cp-file-error;
    // FromTemplate tab
    in property <int> cp-tpl-subtab: 0;
    in property <int> cp-tpl-builtin-count: 0;
    in property <int> cp-tpl-local-count: 0;
    in-out property <string> cp-tpl-search;
    in property <[TemplateItem]> cp-tpl-items;
    in property <bool> cp-tpl-selected: false;
    // sections-picker
    in property <[SchemaItem]> cp-picker-items;
    in-out property <bool> cp-picker-all-checked: false;
    in property <int> cp-picker-selected-count: 0;
    in property <int> cp-picker-total-count: 0;
    callback cp-set-tab(int);
    callback cp-id-edited(string);
    callback cp-name-edited(string);
    callback cp-category-edited(string);
    callback cp-version-edited(string);
    callback cp-file-browse();
    callback cp-tpl-set-subtab(int);
    callback cp-tpl-search-edited(string);
    callback cp-tpl-select-item(int);
    callback cp-picker-toggle-all(bool);
    callback cp-picker-toggle-item(int);
    callback cp-confirm();
    callback cp-cancel();
    callback cp-new-project-clicked();

    // ── Dialog: 克隆项目（项目右键专用，仅复制 + 改 id/name）──────
    in-out property <bool> dlg-new-project-open: false;
    in property <string> np-dialog-title: "复制项目";
    in property <string> np-intro-line;
    in-out property <string> np-project-id;
    in-out property <string> np-project-name;
    in-out property <string> np-project-category;
    in-out property <string> np-project-version;
    in-out property <bool> np-open-after: false;
    in property <bool> np-allow-open-after: false;
    in property <string> np-id-error;
    in property <string> np-name-error;
    in property <bool> np-can-confirm: false;
    callback np-id-edited(string);
    callback np-name-edited(string);
    callback np-category-edited(string);
    callback np-version-edited(string);
    callback np-confirm();
    callback np-cancel();

    // ── Dialog: 项目设置（id/name/category/version + 25 分隔符 leaves）─────
    in-out property <bool> dlg-ps-open: false;
    in-out property <int> ps-tab: 0;
    in-out property <string> ps-id-buf;
    in-out property <string> ps-name-buf;
    in-out property <string> ps-category-buf;
    in-out property <string> ps-version-buf;
    in property <string> ps-id-error;
    in property <bool> ps-can-confirm: true;
    in-out property <string> ps-sep-tuple2;
    in-out property <string> ps-sep-tuple3;
    in-out property <string> ps-sep-tuple4;
    in-out property <string> ps-sep-list;
    in-out property <string> ps-sep-set;
    in-out property <string> ps-sep-map-kv;
    in-out property <string> ps-sep-map-entry;
    in-out property <string> ps-sep-lt2-tuple;
    in-out property <string> ps-sep-lt2-list;
    in-out property <string> ps-sep-lt3-tuple;
    in-out property <string> ps-sep-lt3-list;
    in-out property <string> ps-sep-lt4-tuple;
    in-out property <string> ps-sep-lt4-list;
    in-out property <string> ps-sep-mt2-kv;
    in-out property <string> ps-sep-mt2-tuple;
    in-out property <string> ps-sep-mt2-entry;
    in-out property <string> ps-sep-mt3-kv;
    in-out property <string> ps-sep-mt3-tuple;
    in-out property <string> ps-sep-mt3-entry;
    in-out property <string> ps-sep-mt4-kv;
    in-out property <string> ps-sep-mt4-tuple;
    in-out property <string> ps-sep-mt4-entry;
    in-out property <string> ps-sep-ml-kv;
    in-out property <string> ps-sep-ml-item;
    in-out property <string> ps-sep-ml-entry;
    callback ps-tab-changed(int);
    callback ps-id-edited(string);
    callback ps-name-edited(string);
    callback ps-category-edited(string);
    callback ps-version-edited(string);
    callback ps-sep-edited(string, string);
    callback ps-reset-sep();
    callback ps-confirm();
    callback ps-cancel();

    // ── ContextMenu / InputDialog / ConfirmDialog ───────────
    in property <bool> ctx-menu-open: false;
    in property <length> ctx-menu-x: 0;
    in property <length> ctx-menu-y: 0;
    in property <[CtxMenuItem]> ctx-menu-items;
    callback ctx-menu-action(string);
    callback ctx-menu-dismiss();

    in property <bool> dlg-input-open: false;
    in property <string> dlg-input-title: "输入";
    in property <string> dlg-input-label: "名称:";
    in-out property <string> dlg-input-buffer: "";
    in property <string> dlg-input-error: "";
    in property <bool> dlg-input-can-confirm: false;
    callback inp-set-input(string);
    callback inp-confirm();
    callback inp-cancel();

    in property <bool> dlg-confirm-open: false;
    in property <string> dlg-confirm-title: "确认";
    in property <string> dlg-confirm-message: "";
    callback cf-confirm();
    callback cf-cancel();

    // ── 键盘快捷键 ──────────────────────────────────────────
    // grid 区获得焦点时（focus-sink 抢焦后）触发：复制/剪切/粘贴/删除走与右键菜单同一路径
    callback grid-shortcut-copy();
    callback grid-shortcut-cut();
    callback grid-shortcut-paste();
    callback grid-shortcut-delete();
    callback debug-key(string, bool);  // (text, ctrl) 调试用

    // ── 大区拉伸尺寸 ───────────────────────────────────────
    // TreeSection 宽度、LogPanel 高度由 splitter 拖动调整。
    // tree-w 最小 220px：TreeSection 内层有功能区 border + padding 双层堆叠，
    // 搜索框 + 过滤下拉的最小可读宽度对应外层 220px。
    in-out property <length> tree-w: 240px;
    in-out property <length> log-h: 120px;

    // ── 全局焦点抽屉 ────────────────────────────────────────
    // 用来在点击 tree/cell/toolbar 等区域时抢走 LineEdit/TextInput 的焦点，
    // 配合 Rust 端 commit_editing 让搜索框 / 公式栏 / cell 编辑都"点其它就退出"
    callback drop-focus();
    callback commit-pending-edit();   // Rust 监听：commit 当前 editing buffer 到 cell
    drop-focus => {
        focus-sink.focus();
        root.commit-pending-edit();
    }
    focus-sink := FocusScope {
        x: 0px; y: 0px;
        width: 0px; height: 0px;
        // grid 区点击后焦点会落在这里（drop-focus 调 self.focus()）。
        // 监听 Ctrl+C/V 和 Delete/Backspace；TextEdit/LineEdit 拥有焦点时这里收不到事件，所以编辑态不冲突。
        key-pressed(e) => {
            // 调试：把每个键事件汇报给 Rust
            root.debug-key(e.text, e.modifiers.control);
            // Windows winit：Ctrl+letter 时 e.text 可能是控制字符（\u{3}=Ctrl+C, \u{16}=Ctrl+V），
            // 也可能仍是 "c"/"v"（取决于键盘布局/IME），两种都接住。
            if (e.modifiers.control && (e.text == "c" || e.text == "C" || e.text == "\u{3}")) {
                root.grid-shortcut-copy();
                return accept;
            }
            if (e.modifiers.control && (e.text == "x" || e.text == "X" || e.text == "\u{18}")) {
                root.grid-shortcut-cut();
                return accept;
            }
            if (e.modifiers.control && (e.text == "v" || e.text == "V" || e.text == "\u{16}")) {
                root.grid-shortcut-paste();
                return accept;
            }
            if (e.text == Key.Delete || e.text == Key.Backspace) {
                root.grid-shortcut-delete();
                return accept;
            }
            return reject;
        }
    }
    // 全屏底层 fallback：点击到任何"无人认领的空白"都触发 drop-focus
    // z-order 在所有内容之前，前景的 TouchArea（按钮、cell、节点）会优先吃掉点击；
    // 仅当落在日志区空白、ribbon 空白、toolbar 按钮间隙等无 TouchArea 区域时才命中。
    blank-catcher := TouchArea {
        clicked => { root.drop-focus(); }
    }

    // ── 主布局 ──────────────────────────────────────────────
    VerticalLayout {
        spacing: 0;

        Toolbar {
            btn-clicked(id) => {
                root.drop-focus();
                // 各对话框 open 由 Rust 端在 toolbar wire 内设置，slint 这里仅转发。
                root.toolbar-btn-clicked(id);
            }
        }

        HorizontalLayout {
            spacing: 0;
            vertical-stretch: 1;

            Rectangle {
                width: root.tree-w;
                TreeSection {
                    nodes: root.tree-nodes;
                    filters: root.tree-filters;
                    filter-index: root.tree-filter-index;
                    full-group <=> root.tree-full-group;
                    search <=> root.tree-search;
                    sort-options: root.tree-sort-options;
                    sort-index: root.tree-sort-index;
                    node-clicked(id) => { root.drop-focus(); root.tree-node-clicked(id); }
                    node-double-clicked(id) => { root.drop-focus(); root.tree-node-double-clicked(id); }
                    node-toggle-expand(id) => { root.drop-focus(); root.tree-node-toggle-expand(id); }
                    node-context-menu(id, x, y) => { root.tree-node-context-menu(id, x, y); }
                    blank-context-menu(x, y) => { root.tree-blank-context-menu(x, y); }
                    blank-clicked() => { root.drop-focus(); }
                    filter-changed(i) => { root.tree-filter-index = i; root.tree-filter-changed(i); }
                    search-edited(s) => { root.tree-search-edited(s); }
                    full-group-toggled(c) => { root.tree-full-group-toggled(c); }
                    new-project-clicked() => { root.drop-focus(); root.cp-new-project-clicked(); }
                    sort-changed(i) => { root.tree-sort-index = i; root.tree-sort-changed(i); }
                }
            }

            // ── 横向 splitter：tree ↔ grid ──
            Rectangle {
                width: 4px;
                background: Theme.border-light;
                vsplit := TouchArea {
                    mouse-cursor: ew-resize;
                    moved => {
                        if (self.pressed) {
                            // mouse-x 是 splitter 内坐标；splitter 处于 tree 右侧，
                            // 所以 root.tree-w 直接累加 delta。
                            root.tree-w = max(220px, min(root.tree-w + (self.mouse-x - self.pressed-x), 800px));
                        }
                    }
                }
            }

            GridSection {
                horizontal-stretch: 1;
                title: root.grid-title;
                subtitle: root.grid-subtitle;
                show-enum-name <=> root.show-enum-name;
                show-enum-name-enabled: root.show-enum-name-enabled;
                excel-edit-enabled: root.excel-edit-enabled;
                show-enum-name-toggled(c) => { root.show-enum-name-toggled(c); }
                excel-edit-clicked => { root.excel-edit-clicked(); }
                coord: root.coord;
                formula-display: root.formula-display;
                formula-editable: root.formula-editable;
                formula-editing: root.formula-editing;
                editing-buffer <=> root.editing-buffer;
                formula-request-edit => { root.drop-focus(); root.formula-request-edit(); }
                formula-commit => { root.formula-commit(); }
                formula-cancel => { root.formula-cancel(); }
                header-rows: root.grid-header-rows;
                data-rows: root.grid-data-rows;
                col-count: root.grid-col-count;
                selected-col: root.grid-selected-col;
                selected-row: root.grid-selected-row;
                selected-cell-row: root.grid-selected-cell-row;
                selected-cell-col: root.grid-selected-cell-col;
                range-row-min: root.grid-range-row-min;
                range-row-max: root.grid-range-row-max;
                range-col-min: root.grid-range-col-min;
                range-col-max: root.grid-range-col-max;
                editing-row: root.grid-editing-row;
                editing-col: root.grid-editing-col;
                editing-header-row: root.grid-editing-header-row;
                editing-header-col: root.grid-editing-header-col;
                editing-export-index: root.grid-editing-export-index;
                picker-trigger-header-single: root.picker-trigger-header-single;
                picker-trigger-data-single: root.picker-trigger-data-single;
                column-kinds: root.grid-column-kinds;
                header-clicked(hi, ci) => { root.drop-focus(); root.grid-header-clicked(hi, ci); }
                header-double-clicked(hi, ci) => { root.drop-focus(); root.grid-header-double-clicked(hi, ci); }
                cell-clicked(r, c) => { root.drop-focus(); root.grid-cell-clicked(r, c); }
                cell-shift-clicked(r, c) => { root.drop-focus(); root.grid-cell-shift-clicked(r, c); }
                cell-pressed(r, c) => { root.drop-focus(); root.grid-cell-pressed(r, c); }
                cell-double-clicked(r, c) => { root.drop-focus(); root.grid-cell-double-clicked(r, c); }
                cell-drag(r, c, mx, my) => { root.grid-cell-drag(r, c, mx, my); }
                row-num-clicked(r) => { root.drop-focus(); root.grid-row-num-clicked(r); }
                col-letter-clicked(c) => { root.drop-focus(); root.grid-col-letter-clicked(c); }
                col-context-menu(c, x, y) => { root.grid-col-context-menu(c, x, y); }
                row-context-menu(r, x, y) => { root.grid-row-context-menu(r, x, y); }
                cell-context-menu(r, c, x, y) => { root.grid-cell-context-menu(r, c, x, y); }
                cell-edit-committed() => { root.grid-cell-edit-committed(); }
                cell-edit-canceled() => { root.grid-cell-edit-canceled(); }
                blank-clicked() => { root.drop-focus(); root.grid-blank-clicked(); }
                cell-export-selected(r, c, i) => { root.grid-cell-export-selected(r, c, i); }
                header-export-selected(c, i) => { root.grid-header-export-selected(c, i); }
                selection-info: root.selection-info;
                hover-info: root.hover-info;
            }
        }

        // ── 纵向 splitter：上半 ↔ log ──
        Rectangle {
            height: 4px;
            background: Theme.border-light;
            hsplit := TouchArea {
                mouse-cursor: ns-resize;
                moved => {
                    if (self.pressed) {
                        // splitter 在 log 上方，向上拖（mouse-y 变小）增加 log-h
                        root.log-h = max(40px, min(root.log-h - (self.mouse-y - self.pressed-y), 600px));
                    }
                }
            }
        }

        LogPanel {
            log-height: root.log-h;
            logs: root.logs;
            text-flat: root.logs-text;
        }
    }

    // ── Dialog overlay 层 ───────────────────────────────────
    TypeSelector {
        open: root.dlg-type-open;
        tab: root.ts-tab;
        ref-disabled: root.ts-ref-disabled;
        paradigms: root.ts-paradigms;
        paradigm-index: root.ts-paradigm-index;
        param-slots: root.ts-param-slots;
        result-preview: root.ts-result-preview;
        example-value: root.ts-example-value;
        java-decl: root.ts-java-decl;
        go-decl: root.ts-go-decl;
        lua-decl: root.ts-lua-decl;
        ref-search: root.ts-ref-search;
        ref-items: root.ts-ref-items;
        ref-filter: root.ts-ref-filter;
        set-tab(i) => { root.ts-tab = i; root.ts-set-tab(i); }
        set-paradigm(i) => { root.ts-set-paradigm(i); }
        set-param(slot, idx) => { root.ts-set-param(slot, idx); }
        set-ref-search(s) => { root.ts-set-ref-search(s); }
        set-ref-filter(i) => { root.ts-set-ref-filter(i); }
        select-ref(i) => { root.ts-select-ref(i); }
        confirm => { root.ts-confirm(); root.dlg-type-open = false; }
        cancel => { root.ts-cancel(); root.dlg-type-open = false; }
    }

    RefPicker {
        open: root.dlg-ref-open;
        ref-name: root.rp-ref-name;
        kind-label: root.rp-kind-label;
        target-missing: root.rp-target-missing;
        is-table: root.rp-is-table;
        strategy-index: root.rp-strategy-index;
        id-header: root.rp-id-header;
        headers: root.rp-headers;
        has-desc: root.rp-has-desc;
        search: root.rp-search;
        manual-value <=> root.rp-manual-value;
        rows: root.rp-rows;
        selection-preview: root.rp-selection-preview;
        set-search(s) => { root.rp-search = s; root.rp-search-edited(s); }
        set-strategy(i) => { root.rp-strategy-index = i; root.rp-strategy-changed(i); }
        set-manual(s) => { root.rp-manual-edited(s); }
        select-row(i) => { root.rp-select-row(i); }
        row-double-clicked(i) => { root.rp-row-double-clicked(i); }
        confirm => { root.rp-confirm(); root.dlg-ref-open = false; }
        clear => { root.rp-clear(); root.dlg-ref-open = false; }
        cancel => { root.rp-cancel(); root.dlg-ref-open = false; }
    }

    ExportDialog {
        open: root.dlg-export-open;
        json-checked <=> root.ex-json;
        xml-checked <=> root.ex-xml;
        java-checked <=> root.ex-java;
        go-checked <=> root.ex-go;
        lua-checked <=> root.ex-lua;
        preset-all => { root.ex-json = true; root.ex-xml = true; root.ex-java = true; root.ex-go = true; root.ex-lua = true; }
        preset-data => { root.ex-json = true; root.ex-xml = true; root.ex-java = false; root.ex-go = false; root.ex-lua = false; }
        preset-server => { root.ex-json = true; root.ex-xml = true; root.ex-java = true; root.ex-go = true; root.ex-lua = false; }
        preset-client => { root.ex-json = false; root.ex-xml = false; root.ex-java = false; root.ex-go = false; root.ex-lua = true; }
        confirm => { root.ex-confirm(); root.dlg-export-open = false; }
        cancel => { root.ex-cancel(); root.dlg-export-open = false; }
    }

    SchemaExportDialog {
        open: root.dlg-schema-export-open;
        items: root.sx-items;
        all-checked <=> root.sx-all-checked;
        selected-count: root.sx-selected-count;
        total-count: root.sx-total-count;
        with-preset <=> root.sx-with-preset;
        toggle-all(c) => { root.sx-toggle-all(c); }
        toggle-item(i) => { root.sx-toggle-item(i); }
        confirm => { root.sx-confirm(); root.dlg-schema-export-open = false; }
        cancel => { root.sx-cancel(); root.dlg-schema-export-open = false; }
    }

    SchemaImportDialog {
        open: root.dlg-schema-import-open;
        file-path <=> root.si-file-path;
        file-loaded: root.si-file-loaded;
        items: root.si-items;
        all-checked <=> root.si-all-checked;
        selected-count: root.si-selected-count;
        total-count: root.si-total-count;
        conflict-count: root.si-conflict-count;
        has-preset: root.si-has-preset;
        with-preset <=> root.si-with-preset;
        browse-file => { root.si-browse-file(); }
        toggle-all(c) => { root.si-toggle-all(c); }
        toggle-item(i) => { root.si-toggle-item(i); }
        confirm => { root.si-confirm(); root.dlg-schema-import-open = false; }
        cancel => { root.dlg-schema-import-open = false; }
    }

    CreateProjectDialog {
        open: root.dlg-create-project-open;
        tab-index: root.cp-tab-index;
        project-id <=> root.cp-project-id;
        project-name <=> root.cp-project-name;
        project-category <=> root.cp-project-category;
        project-version <=> root.cp-project-version;
        open-after <=> root.cp-open-after;
        id-error: root.cp-id-error;
        name-error: root.cp-name-error;
        can-confirm: root.cp-can-confirm;
        source-has-preset: root.cp-source-has-preset;
        with-preset <=> root.cp-with-preset;
        file-path <=> root.cp-file-path;
        file-loaded: root.cp-file-loaded;
        file-error: root.cp-file-error;
        tpl-subtab: root.cp-tpl-subtab;
        tpl-builtin-count: root.cp-tpl-builtin-count;
        tpl-local-count: root.cp-tpl-local-count;
        tpl-search <=> root.cp-tpl-search;
        tpl-items: root.cp-tpl-items;
        tpl-selected: root.cp-tpl-selected;
        picker-items: root.cp-picker-items;
        picker-all-checked <=> root.cp-picker-all-checked;
        picker-selected-count: root.cp-picker-selected-count;
        picker-total-count: root.cp-picker-total-count;
        set-tab(i) => { root.cp-set-tab(i); }
        id-edited(s) => { root.cp-id-edited(s); }
        name-edited(s) => { root.cp-name-edited(s); }
        category-edited(s) => { root.cp-category-edited(s); }
        version-edited(s) => { root.cp-version-edited(s); }
        file-browse => { root.cp-file-browse(); }
        tpl-set-subtab(i) => { root.cp-tpl-set-subtab(i); }
        tpl-search-edited(s) => { root.cp-tpl-search-edited(s); }
        tpl-select-item(i) => { root.cp-tpl-select-item(i); }
        picker-toggle-all(c) => { root.cp-picker-toggle-all(c); }
        picker-toggle-item(i) => { root.cp-picker-toggle-item(i); }
        confirm => { root.cp-confirm(); }
        cancel => { root.cp-cancel(); root.dlg-create-project-open = false; }
    }

    NewProjectDialog {
        open: root.dlg-new-project-open;
        dialog-title: root.np-dialog-title;
        intro-line: root.np-intro-line;
        project-id <=> root.np-project-id;
        project-name <=> root.np-project-name;
        project-category <=> root.np-project-category;
        project-version <=> root.np-project-version;
        open-after <=> root.np-open-after;
