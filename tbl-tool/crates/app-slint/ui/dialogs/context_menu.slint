// ContextMenu：浮层右键菜单。条件 Rectangle + 全屏 dismiss TouchArea + 列表项。
// 由 root 控制 open / x / y / items；点击 item 触发 action(string) + 自动关闭。
// 不走 PopupWindow，避免 PopupWindow 的"不能在 if/for 内"限制。

import { Theme } from "../theme.slint";

export struct CtxMenuItem {
    label: string,
    action-id: string,
    is-separator: bool,
    disabled: bool,
}

export component ContextMenu inherits Rectangle {
    in property <bool> open: false;
    in property <length> menu-x: 0;
    in property <length> menu-y: 0;
    in property <[CtxMenuItem]> items;

    callback action(string);
    callback dismiss();

    visible: root.open;
    width: 100%;
    height: 100%;

    if root.open: TouchArea {
        clicked => { root.dismiss(); }
        // 右键也关闭
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                root.dismiss();
            }
        }
    }

    if root.open: Rectangle {
        x: root.menu-x;
        y: root.menu-y;
        // 宽度由内容驱动：取 VerticalLayout 自然 preferred-width（其内最长 Text + padding 决定），
        // 再 clamp 到 [140, 280] 防止过窄/过宽。Rectangle 默认占满父容器，所以必须显式绑。
        width: max(140px, min(280px, vlayout.preferred-width));
        height: vlayout.preferred-height;
        background: Theme.bg-panel;
        border-color: Theme.border;
        border-width: 1px;
        drop-shadow-blur: 6px;
        drop-shadow-color: #00000040;
        vlayout := VerticalLayout {
            padding-top: 4px;
            padding-bottom: 4px;
            spacing: 0;
            for item[i] in root.items: Rectangle {
                height: item.is-separator ? 7px : 28px;
                background: hover-area.has-hover && !item.is-separator && !item.disabled
                    ? Theme.bg-row-selected : transparent;
                if item.is-separator: Rectangle {
                    x: 4px;
                    y: 3px;
                    width: parent.width - 8px;
                    height: 1px;
                    background: Theme.border-light;
                }
                if !item.is-separator: HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    Text {
                        text: item.label;
                        font-size: Theme.fs-small;
                        color: item.disabled ? Theme.text-disabled : Theme.text-primary;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                }
                hover-area := TouchArea {
                    enabled: !item.is-separator && !item.disabled;
                    clicked => {
                        root.action(item.action-id);
                    }
                }
            }
        }
    }
}
