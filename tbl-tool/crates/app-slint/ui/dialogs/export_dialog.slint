// 数据导出对话框：服务端 4 + 客户端 5 + 数据 2 共 11 个勾选 + 4 个预设。
// 对应 docs/04-导出功能.md。

import { Theme } from "../theme.slint";
import { DialogChrome } from "dialog_chrome.slint";
import { Button, CheckBox } from "std-widgets.slint";

export component ExportDialog inherits Rectangle {
    in property <bool> open: false;

    in-out property <bool> json-checked: true;
    in-out property <bool> xml-checked: true;

    in-out property <bool> java-checked: true;
    in-out property <bool> go-checked: true;
    in-out property <bool> cpp-checked: true;
    in-out property <bool> csharp-dotnet-checked: true;

    in-out property <bool> lua-checked: true;
    in-out property <bool> gdscript-checked: true;
    in-out property <bool> typescript-checked: true;
    in-out property <bool> csharp-unity-checked: true;
    in-out property <bool> csharp-godot-checked: true;

    callback preset-all();
    callback preset-data();
    callback preset-server();
    callback preset-client();
    callback confirm();
    callback cancel();

    visible: root.open;
    width: 100%;
    height: 100%;

    DialogChrome {
        title: "导出";
        dialog-w: 420px;
        dialog-h: 460px;
        primary-text: "导出";
        primary-enabled:
               root.json-checked || root.xml-checked
            || root.java-checked || root.go-checked || root.cpp-checked || root.csharp-dotnet-checked
            || root.lua-checked || root.gdscript-checked || root.typescript-checked
            || root.csharp-unity-checked || root.csharp-godot-checked;
        primary-clicked => { root.confirm(); }
        cancel-clicked => { root.cancel(); }
        scrim-clicked => { root.cancel(); }

        VerticalLayout {
            padding: Theme.sp-4;
            spacing: Theme.sp-3;

            Text {
                text: "快捷预设";
                font-size: Theme.fs-tiny;
                color: Theme.text-secondary;
            }

            HorizontalLayout {
                spacing: Theme.sp-2;
                Button { text: "全部"; clicked => { root.preset-all(); } }
                Button { text: "数据"; clicked => { root.preset-data(); } }
                Button { text: "后端"; clicked => { root.preset-server(); } }
                Button { text: "前端"; clicked => { root.preset-client(); } }
            }

            Rectangle { height: 1px; background: Theme.border-light; }

            // 数据格式
            Text {
                text: "数据";
                font-size: Theme.fs-tiny;
                color: Theme.text-secondary;
            }
            HorizontalLayout {
                spacing: Theme.sp-4;
                CheckBox { text: "JSON"; checked <=> root.json-checked; }
                CheckBox { text: "XML"; checked <=> root.xml-checked; }
            }

            // 服务端
            Text {
                text: "服务端";
                font-size: Theme.fs-tiny;
                color: Theme.text-secondary;
            }
            HorizontalLayout {
                spacing: Theme.sp-4;
                CheckBox { text: "Java"; checked <=> root.java-checked; }
                CheckBox { text: "Go"; checked <=> root.go-checked; }
                CheckBox { text: "C++"; checked <=> root.cpp-checked; }
                CheckBox { text: "C# (.NET)"; checked <=> root.csharp-dotnet-checked; }
            }

            // 客户端
            Text {
                text: "客户端";
                font-size: Theme.fs-tiny;
                color: Theme.text-secondary;
            }
            GridLayout {
                spacing: Theme.sp-4;
                Row {
                    CheckBox { text: "Lua"; checked <=> root.lua-checked; }
                    CheckBox { text: "GDScript"; checked <=> root.gdscript-checked; }
                    CheckBox { text: "TypeScript"; checked <=> root.typescript-checked; }
                }
                Row {
                    CheckBox { text: "C# (Unity)"; checked <=> root.csharp-unity-checked; }
                    CheckBox { text: "C# (Godot)"; checked <=> root.csharp-godot-checked; }
                    Rectangle {}
                }
            }

            Rectangle { vertical-stretch: 1; }
        }
    }
}

export component ExportDialogPreview inherits Window {
    title: "ExportDialog Preview";
    width: 540px;
    height: 540px;

    ExportDialog {
        open: true;
    }
}
