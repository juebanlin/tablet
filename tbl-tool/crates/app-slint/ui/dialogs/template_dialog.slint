// 新建项目对话框（@docs/04-UI设计.md §6.7）。
//
// 经 S15-X 整合，「模板库」入口已并入统一 CreateProjectDialog（3 tab + 单页左右分栏）。
// 本文件保留 NewProjectDialog 仅服务「复制(克隆)项目」路径（项目右键 → 「复制(克隆)...」）。
// TemplateItem struct 仍 export，被 CreateProjectDialog 复用。

import { Theme } from "../theme.slint";
import { DialogChrome } from "dialog_chrome.slint";
import { Button, CheckBox, LineEdit, ScrollView } from "std-widgets.slint";

export struct TemplateItem {
    id: string,
    name: string,
    category: string,
    version: string,
    source: string,         // "builtin" / "local"
    sections: int,          // section 数量
    selected: bool,
}

// ── 复制(克隆)项目 ─────────────────────────────────────────────
export component NewProjectDialog inherits Rectangle {
    in property <bool> open: false;
    in property <string> dialog-title: "复制项目";
    /// 介绍行：克隆 = "源项目：xxx"
    in property <string> intro-line;
    in-out property <string> project-id;
    in-out property <string> project-name;
    in-out property <string> project-category;
    in-out property <string> project-version;
    in-out property <bool> open-after: false;
    /// 克隆模式置 false：禁用 open-after 复选框
    in property <bool> allow-open-after: false;
    in property <string> id-error;
    in property <string> name-error;
    in property <bool> can-confirm: false;

    callback id-edited(string);
    callback name-edited(string);
    callback category-edited(string);
    callback version-edited(string);
    callback confirm();
    callback cancel();

    visible: root.open;
    width: 100%;
    height: 100%;

    DialogChrome {
        title: root.dialog-title;
        dialog-w: 460px;
        dialog-h: 320px;
        primary-text: "创建";
        primary-enabled: root.can-confirm;
        primary-clicked => { root.confirm(); }
        cancel-clicked => { root.cancel(); }
        scrim-clicked => { root.cancel(); }

        VerticalLayout {
            padding: Theme.sp-4;
            spacing: Theme.sp-3;

            if root.intro-line != "": Text {
                text: root.intro-line;
                font-size: Theme.fs-small;
                color: Theme.text-primary;
            }
            if root.intro-line != "": Rectangle { height: 1px; background: Theme.border-light; }

            HorizontalLayout {
                spacing: Theme.sp-2;
                Text {
                    text: "项目 ID:";
                    font-size: Theme.fs-small;
                    width: 64px;
                    vertical-alignment: center;
                }
                LineEdit {
                    text: root.project-id;
                    placeholder-text: "[a-z0-9_-]{1,32}";
                    edited(s) => { root.id-edited(s); }
                }
            }
            if root.id-error != "": Text {
                text: root.id-error;
                font-size: Theme.fs-tiny;
                color: Theme.text-error;
            }

            HorizontalLayout {
                spacing: Theme.sp-2;
                Text {
                    text: "项目名:";
                    font-size: Theme.fs-small;
                    width: 64px;
                    vertical-alignment: center;
                }
                LineEdit {
                    text: root.project-name;
                    placeholder-text: "可中文，仅用于显示";
                    edited(s) => { root.name-edited(s); }
                }
            }
            if root.name-error != "": Text {
                text: root.name-error;
                font-size: Theme.fs-tiny;
                color: Theme.text-error;
            }

            HorizontalLayout {
                spacing: Theme.sp-2;
                Text {
                    text: "分类:";
                    font-size: Theme.fs-small;
                    width: 64px;
                    vertical-alignment: center;
                }
                LineEdit {
                    text: root.project-category;
                    placeholder-text: "test / slg / rpg / ...";
                    edited(s) => { root.category-edited(s); }
                }
            }

            HorizontalLayout {
                spacing: Theme.sp-2;
                Text {
                    text: "版本:";
                    font-size: Theme.fs-small;
                    width: 64px;
                    vertical-alignment: center;
                }
                LineEdit {
                    text: root.project-version;
                    placeholder-text: "1.0.0";
                    edited(s) => { root.version-edited(s); }
                }
            }

            Text {
                text: "目录预览：projects/" + root.project-id + "/";
                font-size: Theme.fs-tiny;
                color: Theme.text-secondary;
            }

            CheckBox {
                text: "立即打开新项目";
                checked <=> root.open-after;
                enabled: root.allow-open-after;
            }
            if !root.allow-open-after: Text {
                text: "（克隆项目需保存后才能打开）";
                font-size: Theme.fs-tiny;
                color: Theme.text-secondary;
            }

            Rectangle { vertical-stretch: 1; }
        }
    }
}

// ── 预览 ─────────────────────────────────────────────
export component NewProjectDialogPreview inherits Window {
    title: "NewProject Preview";
    width: 600px;
    height: 480px;

    NewProjectDialog {
        open: true;
        dialog-title: "复制项目";
        intro-line: "源项目：my-slg";
        project-id: "my-slg_copy";
        project-name: "我的 SLG 项目_copy";
        project-category: "slg";
        project-version: "1.0.0";
        open-after: false;
        allow-open-after: false;
        can-confirm: true;
    }
}
