// 全局主题：颜色、字号、间距。其它 .slint 文件统一从这里取。
// 与 egui 端的视觉对齐：参见 docs/02-UI设计.md。

export global Theme {
    // 文字色
    out property <color> text-primary: #1a1a1a;
    out property <color> text-secondary: #5a5a5a;
    out property <color> text-disabled: #6e6e6e;
    out property <color> text-readonly: #6e6e6e;       // ReadOnly 表头文字（gray 110）
    out property <color> text-error: #dc3232;
    out property <color> text-success: #50a050;
    out property <color> text-info: #5082d2;

    // 背景
    out property <color> bg-window: #f5f5f5;
    out property <color> bg-panel: #ffffff;
    out property <color> bg-toolbar: #fafafa;
    out property <color> bg-header: #f0f0f0;            // 普通表头底（gray 240）
    out property <color> bg-header-readonly: #c8c8c8;   // ReadOnly 表头底（gray 200）
    out property <color> bg-row-alt: #f8f8f8;
    out property <color> bg-row-selected: #b4d7ff;
    out property <color> bg-row-hover: #e6effa;
    out property <color> bg-cell-selected: #b4d7ff;
    out property <color> scrim: #00000060;              // 模态遮罩

    // 边框
    out property <color> border: #b4b4b4;
    out property <color> border-light: #dadada;
    out property <color> border-selected: #3278c8;
    out property <color> border-error: #dc3232;

    // 状态标记
    out property <color> mark-new: #50a050;
    out property <color> mark-modified: #d8a020;
    out property <color> mark-deleted: #dc3232;

    // 字号
    out property <length> fs-tiny: 11px;
    out property <length> fs-small: 12px;
    out property <length> fs-normal: 13px;
    out property <length> fs-heading: 16px;

    // 间距
    out property <length> sp-1: 2px;
    out property <length> sp-2: 4px;
    out property <length> sp-3: 6px;
    out property <length> sp-4: 8px;
    out property <length> sp-5: 12px;
    out property <length> sp-6: 16px;

    // 控件高度
    out property <length> row-h: 22px;
    out property <length> toolbar-h: 32px;
    out property <length> ribbon-h: 24px;
    out property <length> formula-h: 22px;
    out property <length> status-h: 20px;
    out property <length> btn-h: 26px;

    // 列宽
    out property <length> col-w: 100px;
    out property <length> row-num-w: 32px;
}
