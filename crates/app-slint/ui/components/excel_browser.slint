import { Theme } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";

export component ExcelBrowser inherits Rectangle {
    in property <[string]> files;
    in-out property <[bool]> selected: [];
    in property <bool> has-selection: false;

    callback sync-clicked();
    callback delete-clicked();
    callback refresh-clicked();
    callback file-opened(int);

    background: Theme.bg-panel;
    VerticalLayout {
        spacing: 0;
        Rectangle {
            height: 22px;
            background: Theme.bg-toolbar;
            border-color: Theme.border-light; border-width: 1px;
            HorizontalLayout {
                spacing: Theme.sp-1; padding-left: Theme.sp-2; alignment: start;
                Rectangle { width: 40px; height: 18px;
                    background: Theme.bg-row-hover; border-radius: 2px;
                    Text { text: "同步"; font-size: Theme.fs-tiny; color: Theme.text-secondary; vertical-alignment: center; horizontal-alignment: center; }
                    TouchArea { clicked => { root.sync-clicked(); } }
                }
                Rectangle { width: 40px; height: 18px;
                    background: Theme.bg-row-hover; border-radius: 2px;
                    Text { text: "刷新"; font-size: Theme.fs-tiny; color: Theme.text-secondary; vertical-alignment: center; horizontal-alignment: center; }
                    TouchArea { clicked => { root.refresh-clicked(); } }
                }
                Rectangle { width: 40px; height: 18px;
                    opacity: root.has-selection ? 1.0 : 0.4;
                    background: Theme.bg-row-hover; border-radius: 2px;
                    Text { text: "删除"; font-size: Theme.fs-tiny; color: Theme.text-secondary; vertical-alignment: center; horizontal-alignment: center; }
                    TouchArea { clicked => { if root.has-selection { root.delete-clicked(); } } }
                }
                Rectangle { width: 40px; height: 18px;
                    background: Theme.bg-row-hover; border-radius: 2px;
                    Text { text: "打开"; font-size: Theme.fs-tiny; color: Theme.text-secondary; vertical-alignment: center; horizontal-alignment: center; }
                    TouchArea { clicked => { root.open-selected(); } }
                }
            }
        }
        ScrollView {
            VerticalLayout { spacing: 4px; padding: 4px;
                if root.files.length == 0 : Rectangle { height: 22px;
                    Text { x: 6px; text: "(无 Excel 文件)"; font-size: Theme.fs-tiny; color: Theme.text-disabled; vertical-alignment: center; }
                }
                for file[i] in root.files : Rectangle {
                    height: 30px;
                    border-width: 1px; border-radius: 3px;
                    border-color: root.selected[i] ? Theme.border-selected : Theme.border-light;
                    background: root.selected[i] ? Theme.bg-row-selected : Theme.bg-panel;
                    Text {
                        x: 8px; text: "📄 " + file;
                        font-size: Theme.fs-small; color: Theme.text-primary; vertical-alignment: center;
                    }
                    if root.selected[i] : Rectangle {
                        x: parent.width - 24px; y: 6px; width: 16px; height: 16px;
                        border-radius: 2px; background: Theme.bg-row-selected;
                        Text { text: "✓"; font-size: Theme.fs-tiny; color: Theme.text-secondary; vertical-alignment: center; horizontal-alignment: center; }
                    }
                    TouchArea {
                        double-clicked => { root.file-opened(i); }
                        clicked => { root.toggle-file(i); }
                    }
                }
            }
        }
    }

    callback toggle-file(int);
    callback open-selected();
}
