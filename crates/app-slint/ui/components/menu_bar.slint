// 顶部菜单栏：单行菜单按钮 + 下拉项。
// 当前仅一个「关于」菜单，点开后展示「检查更新」入口。
// 设计遵循 ContextMenu 同类的「全屏 dismiss touchArea + 浮层 Rectangle」模式
// （dialogs/context_menu.slint），避免使用 PopupWindow 带来的"不能在 if/for 内"限制。

import { Theme } from "../theme.slint";

export component MenuBar inherits Rectangle {
    callback check-update-clicked();

    height: 24px;
    background: Theme.bg-toolbar;
    border-color: Theme.border-light;
    border-width: 1px;

    in-out property <bool> about-open: false;

    HorizontalLayout {
        padding-left: Theme.sp-3;
        padding-right: Theme.sp-3;
        spacing: 0;
        alignment: start;

        Rectangle {
            width: 56px;
            height: 100%;
            background: about-touch.has-hover || root.about-open ? Theme.bg-row-hover : transparent;

            Text {
                text: "关于";
                font-size: Theme.fs-normal;
                color: Theme.text-primary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            about-touch := TouchArea {
                clicked => { root.about-open = !root.about-open; }
            }
        }
    }

    // 全屏 dismiss：点其它任何位置关闭下拉。覆盖 menubar 下方所有窗口区域。
    if root.about-open: TouchArea {
        x: 0;
        y: parent.height;
        width: 9999px;
        height: 9999px;
        clicked => { root.about-open = false; }
        // 右键也关
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                root.about-open = false;
            }
        }
    }

    // 「关于」下拉浮层
    if root.about-open: Rectangle {
        x: Theme.sp-3;
        y: parent.height;
        width: 140px;
        height: 32px;
        background: Theme.bg-panel;
        border-color: Theme.border;
        border-width: 1px;
        drop-shadow-blur: 6px;
        drop-shadow-color: #00000040;

        Rectangle {
            background: item-touch.has-hover ? Theme.bg-row-selected : transparent;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                Text {
                    text: "检查更新";
                    font-size: Theme.fs-small;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                    horizontal-alignment: left;
                }
            }
            item-touch := TouchArea {
                clicked => {
                    root.about-open = false;
                    root.check-update-clicked();
                }
            }
        }
    }
}

export component MenuBarPreview inherits Window {
    title: "MenuBar Preview";
    width: 720px;
    height: 200px;

    MenuBar {
        check-update-clicked => { /* preview 不接 */ }
    }
}
