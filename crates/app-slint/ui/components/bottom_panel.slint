// 底部面板：TabBar + 日志/Excel文件 两个 tab 切换。

import { Theme } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";
import { TabBar } from "tab_bar.slint";
import { ExcelBrowser } from "excel_browser.slint";

export struct LogRow {
    time: string,
    // 0 = info, 1 = warn, 2 = error
    level: int,
    message: string,
}

component LogChip inherits Rectangle {
    in property <string> label: "";
    in property <int> index: 0;
    in property <int> current: 0;
    callback picked(int);
    width: 54px;
    height: 18px;
    border-radius: 2px;
    background: index == current ? Theme.bg-row-hover : transparent;
    Text {
        text: root.label;
        font-size: Theme.fs-tiny;
        color: index == current ? Theme.text-primary : Theme.text-secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea { clicked => { root.picked(root.index); } }
}

export component BottomPanel inherits Rectangle {
    // 日志 tab
    in property <[LogRow]> log-rows;
    in property <int> log-filter: 0;
    in property <string> log-summary: "";
    // Excel 文件 tab
    in property <[string]> excel-files;
    // 已选中的文件
    in-out property <[bool]> excel-selected: [];
    in property <bool> excel-has-selection: false;

    // 面板高度（由 app.slint 的 root.log-h 控制，保持 splitter 兼容）
    in property <length> panel-height: 120px;
    height: root.panel-height;
    background: Theme.bg-panel;
    border-color: Theme.border-light;
    border-width: 1px;

    VerticalLayout {
        spacing: 0;

        TabBar {
            labels: ["日志", "Excel 文件"];
            current: root.bottom-tab;
            changed(i) => { root.bottom-tab = i; }
        }

        // 日志内容区
        if root.bottom-tab == 0 : Rectangle {
            vertical-stretch: 1;
            background: Theme.bg-panel;
            VerticalLayout {
                spacing: 0;
                // 日志按钮行
                Rectangle {
                    height: 22px;
                    background: Theme.bg-toolbar;
                    border-color: Theme.border-light;
                    border-width: 1px;
                    HorizontalLayout {
                        padding-left: Theme.sp-2;
                        padding-right: Theme.sp-2;
                        spacing: 2px;
                        alignment: start;
                        Rectangle {
                            width: 48px; height: 18px;
                            background: Theme.bg-row-hover;
                            border-radius: 2px;
                            Text {
                                text: "清空";
                                font-size: Theme.fs-tiny;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                            TouchArea { clicked => { root.clear-log-clicked(); } }
                        }
                        Rectangle { width: 6px; }
                        LogChip { label: "全部"; index: 0; current: root.log-filter; picked(i) => { root.log-filter-changed(i); } }
                        LogChip { label: "Info"; index: 1; current: root.log-filter; picked(i) => { root.log-filter-changed(i); } }
                        LogChip { label: "Warn"; index: 2; current: root.log-filter; picked(i) => { root.log-filter-changed(i); } }
                        LogChip { label: "Error"; index: 3; current: root.log-filter; picked(i) => { root.log-filter-changed(i); } }
                        Text {
                            text: root.log-summary;
                            font-size: Theme.fs-tiny;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            horizontal-alignment: right;
                            overflow: elide;
                        }
                    }
                }
                // 日志内容
                ScrollView {
                    VerticalLayout {
                        padding-left: Theme.sp-2;
                        padding-right: Theme.sp-2;
                        padding-top: 2px;
                        spacing: 0;
                        for row in root.log-rows: HorizontalLayout {
                            height: 18px;
                            spacing: Theme.sp-2;
                            padding-left: 2px;
                            Text {
                                text: row.time;
                                font-size: Theme.fs-tiny;
                                color: Theme.text-secondary;
                                width: 54px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: row.level == 2 ? "ERROR" : row.level == 1 ? "WARN" : "INFO";
                                font-size: Theme.fs-tiny;
                                color: row.level == 2 ? Theme.text-error : row.level == 1 ? Theme.text-warning : Theme.text-secondary;
                                width: 38px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: row.message;
                                font-size: Theme.fs-tiny;
                                color: row.level == 2 ? Theme.text-error : row.level == 1 ? Theme.text-warning : Theme.text-primary;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }

        // Excel 文件内容区
        if root.bottom-tab == 1 : Rectangle {
            vertical-stretch: 1;
            background: Theme.bg-panel;
            ExcelBrowser {
                files: root.excel-files;
                selected: root.excel-selected;
                has-selection: root.excel-has-selection;
                sync-clicked => { root.excel-sync-clicked(); }
                delete-clicked => { root.excel-delete-clicked(); }
                refresh-clicked => { root.excel-refresh-clicked(); }
                open-folder-clicked => { root.excel-open-folder-clicked(); }
                file-opened(idx) => { root.excel-file-opened(idx); }
                select-file(i) => { root.excel-select-file(i); }
                toggle-file(i) => { root.excel-toggle-file(i); }
                open-selected => { root.excel-open-selected(); }
            }
        }
    }

    // ══ properties & callbacks ══
    in-out property <int> bottom-tab: 0;
    callback bottom-tab-changed(int);
    callback clear-log-clicked();
    callback log-filter-changed(int);
    callback excel-sync-clicked();
    callback excel-delete-clicked();
    callback excel-refresh-clicked();
    callback excel-open-folder-clicked();
    callback excel-file-opened(int);
    callback excel-select-file(int);
    callback excel-toggle-file(int);
    callback excel-open-selected();
}
