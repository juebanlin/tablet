        sep-edited(k, v) => { root.gs-sep-edited(k, v); }
        export-field-edited(k, v) => { root.gs-export-field-edited(k, v); }
        ui-revert(k) => { root.gs-ui-revert(k); }
        sep-revert(k) => { root.gs-sep-revert(k); }
        export-revert(k) => { root.gs-export-revert(k); }
        reset-clicked => { root.gs-reset-clicked(); }
        confirm => { root.gs-confirm(); }
        cancel => { root.gs-cancel(); }
    }

    InputDialog {
        open: root.dlg-input-open;
        title: root.dlg-input-title;
        label-text: root.dlg-input-label;
        input-buffer <=> root.dlg-input-buffer;
        error-text: root.dlg-input-error;
        hint-text: root.dlg-input-hint;
        can-confirm: root.dlg-input-can-confirm;
        set-input(s) => { root.inp-set-input(s); }
        confirm => { root.inp-confirm(); }
        cancel => { root.inp-cancel(); }
    }

    ConfirmDialog {
        open: root.dlg-confirm-open;
        title: root.dlg-confirm-title;
        message: root.dlg-confirm-message;
        confirm => { root.cf-confirm(); }
        cancel => { root.cf-cancel(); }
    }

    AlertDialog {
        open: root.dlg-alert-open;
        title: root.dlg-alert-title;
        message: root.dlg-alert-message;
        close => { root.dlg-alert-closed(); }
    }

    // Excel 同步面板
    ExcelSyncDialog {
        open: root.dlg-excel-sync-open;
        rows: root.es-rows;
        refresh => { root.es-refresh(); }
        close => { root.es-close(); }
        action(group, node, code) => { root.es-action(group, node, code); }
    }

    // ContextMenu 必须放在最顶层（z 在所有 dialog 之上），点击 item 触发 ctx-menu-action
    ContextMenu {
        open: root.ctx-menu-open;
        menu-x: root.ctx-menu-x;
        menu-y: root.ctx-menu-y;
        items: root.ctx-menu-items;
        action(id) => { root.ctx-menu-action(id); }
        dismiss => { root.ctx-menu-dismiss(); }
    }

    // Excel 编辑模式弹窗（@docs/06-Excel桥接.md §2 / §3）：
    // session 进行中显示全屏 overlay，屏蔽所有背景 UI 操作（防止用户在内存模型上
    // 改动 → xlsx 关闭后 patch 覆盖 = 数据丢失）。放在 ContextMenu 之后保证 z 最高。
    if root.excel-session-active: Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.scrim;
        // 全屏 TouchArea：吃掉所有点击 / 拖拽事件，不响应——纯屏蔽。
        TouchArea {
            width: 100%;
            height: 100%;
        }
        Rectangle {
            x: (parent.width - 480px) / 2;
            y: (parent.height - 240px) / 2;
            width: 480px;
            height: 240px;
            background: Theme.bg-panel;
            border-color: Theme.border;
            border-width: 1px;
            drop-shadow-blur: 8px;
            drop-shadow-color: #00000040;

            VerticalLayout {
                padding: Theme.sp-6;
                spacing: Theme.sp-5;

                Text {
                    text: "正在 Excel 中编辑";
                    font-size: Theme.fs-heading;
                    font-weight: 700;
                    color: Theme.text-primary;
                }
                Text {
                    text: root.excel-session-status;
                    font-size: Theme.fs-normal;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                Text {
                    text: "请在外部 Excel 中完成编辑后关闭文件，工具会自动合并改动。\n4 小时后未关闭将自动放弃本次编辑。";
                    font-size: Theme.fs-small;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: end;
                    Button {
                        text: "强制放弃（不合并）";
                        clicked => { root.excel-modal-cancel-clicked(); }
                    }
                }
            }
        }
    }
}

