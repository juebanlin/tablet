import { Theme } from "../theme.slint";
import { DialogChrome } from "dialog_chrome.slint";
import { ScrollView } from "std-widgets.slint";

export struct EsRow {
    group: string,
    node: string,
    checked: bool,
    la: int, lr: int, lm: int,
    left_only: bool,
    ra: int, rr: int, rm: int,
    right_sheet: string,
    right_xlsx: string,
    right_only: bool,
    blocked: bool,
    blocked_reason: string,
    hdr_match: bool,
    hdr_tail: bool,
    hdr_mismatch: bool,
}

export component ExcelSyncDialog inherits Rectangle {
    in property <bool> open: false;
    in property <[EsRow]> rows;

    callback close();
    callback refresh();
    // action(row-index, action-code)
    // 1=PushData 2=PullData 3=PushWithCols 4=PullWithCols
    // 5=ForcePush 6=ForcePull 7=Create 8=Import
    callback action(int, int);

    width: 100%; height: 100%;
    visible: root.open;

    if root.open : DialogChrome {
        title: "Excel 同步";
        dialog-w: 900px;
        dialog-h: 550px;
        primary-text: "刷新";
        cancel-text: "关闭";
        primary-clicked => { root.refresh(); }
        cancel-clicked => { root.close(); }
        scrim-clicked => { root.close(); }

        Rectangle { vertical-stretch: 1;
            VerticalLayout { spacing: 0; padding: 4px;
                // Column headers
                Rectangle { height: 22px; background: Theme.bg-header;
                    HorizontalLayout { padding-left: 4px; spacing: 4px;
                        Rectangle { width: 16px; }
                        Rectangle { width: 60px;
                            Text { text: "组名"; font-size: Theme.fs-tiny; color: Theme.text-secondary; vertical-alignment: center; }
                        }
                        Rectangle { width: 100px;
                            Text { text: "节点/Sheet"; font-size: Theme.fs-tiny; color: Theme.text-secondary; vertical-alignment: center; }
                        }
                        Rectangle { width: 70px;
                            Text { text: "tablet"; font-size: Theme.fs-tiny; color: Theme.text-secondary; vertical-alignment: center; }
                        }
                        Rectangle { width: 130px;
                            Text { text: "操作"; font-size: Theme.fs-tiny; color: Theme.text-secondary; vertical-alignment: center; }
                        }
                        Rectangle { width: 70px;
                            Text { text: "Excel"; font-size: Theme.fs-tiny; color: Theme.text-secondary; vertical-alignment: center; }
                        }
                    }
                }
                ScrollView {
                    VerticalLayout { spacing: 1px;
                        for row[i] in root.rows : Rectangle { height: Theme.row-h;
                            HorizontalLayout { padding-left: 4px; spacing: 4px;
                                Rectangle { width: 16px; height: 16px;
                                    background: row.checked ? Theme.bg-row-selected : Theme.bg-panel;
                                    border-color: Theme.border-light; border-width: 1px;
                                    Text { text: " "; font-size: Theme.fs-tiny; vertical-alignment: center; horizontal-alignment: center; }
                                }
                                Text {
                                    text: row.group + "/" + row.node;
                                    font-size: Theme.fs-small; color: Theme.text-primary;
                                    vertical-alignment: center; width: 160px;
                                }
                                // tablet diff
                                if row.left_only : Rectangle { width: 70px;
                                    Text { text: "(新节点)"; font-size: Theme.fs-tiny; color: Theme.text-info; vertical-alignment: center; }
                                }
                                if !row.left_only : Rectangle { width: 70px;
                                    Text {
                                        text: row.la > 0 ? "+" + (row.la) : row.lm > 0 ? "*" + (row.lm) : "=";
                                        font-size: Theme.fs-tiny;
                                        color: row.la > 0 ? Theme.text-success : row.lm > 0 ? Theme.mark-modified : Theme.text-disabled;
                                        vertical-alignment: center;
                                    }
                                }
                                // Action buttons column
                                Rectangle { width: 130px;
                                    HorizontalLayout { spacing: 2px;
                                        // Matched headers: PushData(1) + PullData(2)
                                        if row.hdr_match || row.hdr_tail : Rectangle {
                                            width: 28px; height: 18px; background: Theme.bg-row-hover; border-radius: 2px;
                                            Text { text: "→"; font-size: Theme.fs-tiny; color: Theme.text-primary; vertical-alignment: center; horizontal-alignment: center; }
                                            TouchArea { clicked => { root.action(i, 1); } }
                                        }
                                        if row.hdr_match || row.hdr_tail : Rectangle {
                                            width: 28px; height: 18px; background: Theme.bg-row-hover; border-radius: 2px;
                                            Text { text: "←"; font-size: Theme.fs-tiny; color: Theme.text-primary; vertical-alignment: center; horizontal-alignment: center; }
                                            TouchArea { clicked => { root.action(i, 2); } }
                                        }
                                        // Tail diff: PushWithCols(3)
                                        if row.hdr_tail : Rectangle {
                                            width: 50px; height: 18px; background: Theme.bg-row-hover; border-radius: 2px;
                                            Text { text: "→+列"; font-size: Theme.fs-tiny; color: Theme.text-info; vertical-alignment: center; horizontal-alignment: center; }
                                            TouchArea { clicked => { root.action(i, 3); } }
                                        }
                                        // Mismatch: ForcePush(5) ForcePull(6)
                                        if row.hdr_mismatch : Rectangle {
                                            width: 48px; height: 18px; background: Theme.bg-row-hover; border-radius: 2px;
                                            Text { text: "强制→"; font-size: Theme.fs-tiny; color: Theme.mark-modified; vertical-alignment: center; horizontal-alignment: center; }
                                            TouchArea { clicked => { root.action(i, 5); } }
                                        }
                                        if row.hdr_mismatch : Rectangle {
                                            width: 48px; height: 18px; background: Theme.bg-row-hover; border-radius: 2px;
                                            Text { text: "←强制"; font-size: Theme.fs-tiny; color: Theme.mark-modified; vertical-alignment: center; horizontal-alignment: center; }
                                            TouchArea { clicked => { root.action(i, 6); } }
                                        }
                                        // Left only: Create(7)
                                        if row.left_only : Rectangle {
                                            width: 48px; height: 18px; background: Theme.bg-row-hover; border-radius: 2px;
                                            Text { text: "→创建"; font-size: Theme.fs-tiny; color: Theme.text-primary; vertical-alignment: center; horizontal-alignment: center; }
                                            TouchArea { clicked => { root.action(i, 7); } }
                                        }
                                        // Right only: Import(8)
                                        if row.right_only && !row.blocked : Rectangle {
                                            width: 48px; height: 18px; background: Theme.bg-row-hover; border-radius: 2px;
                                            Text { text: "←导入"; font-size: Theme.fs-tiny; color: Theme.text-primary; vertical-alignment: center; horizontal-alignment: center; }
                                            TouchArea { clicked => { root.action(i, 8); } }
                                        }
                                        // Blocked
                                        if row.blocked : Rectangle { width: 28px; height: 18px;
                                            Text { text: "⛔"; font-size: Theme.fs-tiny; color: Theme.text-error; vertical-alignment: center; horizontal-alignment: center; }
                                        }
                                    }
                                }
                                // Excel diff
                                if row.right_only : Rectangle { width: 70px;
                                    Text { text: "(新sheet)"; font-size: Theme.fs-tiny; color: Theme.text-info; vertical-alignment: center; }
                                }
                                if !row.right_only : Rectangle { width: 70px;
                                    Text {
                                        text: row.ra > 0 ? "+" + (row.ra) : row.rm > 0 ? "*" + (row.rm) : "=";
                                        font-size: Theme.fs-tiny;
                                        color: row.ra > 0 ? Theme.text-success : row.rm > 0 ? Theme.mark-modified : Theme.text-disabled;
                                        vertical-alignment: center;
                                    }
                                }
                                if row.blocked : Text {
                                    text: row.blocked-reason;
                                    font-size: Theme.fs-tiny; color: Theme.text-error; vertical-alignment: center; width: 120px;
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                    }
                }
            }
        }
    }
}
