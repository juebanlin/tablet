import { Theme } from "../theme.slint";
import { DialogChrome } from "dialog_chrome.slint";
import { ScrollView } from "std-widgets.slint";

export struct EsRow {
    group: string,
    node: string,
    checked: bool,
    lrows: int, lcols: int,    // tablet 行数×列数
    la: int, lr: int, lm: int,
    left_only: bool,
    rrows: int, rcols: int,    // xlsx 行数×列数
    ra: int, rr: int, rm: int,
    right_sheet: string,
    right_xlsx: string,
    right_only: bool,
    blocked: bool,
    blocked_reason: string,
    hdr_match: bool,
    tbl_more_cols: bool,
    xlsx_more_cols: bool,
    hdr_mismatch: bool,
    has_diff: bool,
}

export component ExcelSyncDialog inherits Rectangle {
    in property <bool> open: false;
    in property <[EsRow]> rows;
    callback close(); callback refresh();
    callback action(int, int);

    width: 100%; height: 100%; visible: root.open;

    if root.open : DialogChrome {
        title: "Excel 同步";
        dialog-w: 900px; dialog-h: 550px;
        primary-text: "刷新"; cancel-text: "关闭";
        primary-clicked => { root.refresh(); }
        cancel-clicked => { root.close(); }
        scrim-clicked => { root.close(); }

        Rectangle { vertical-stretch: 1;
            VerticalLayout { spacing: 0; padding: 4px;
                Rectangle { height: 22px; background: Theme.bg-header;
                    HorizontalLayout { padding-left: 4px; spacing: 4px;
                        Rectangle { width: 16px; }
                        Rectangle { width: 60px;
                            Text { text: "组名"; font-size: Theme.fs-tiny; color: Theme.text-secondary; vertical-alignment: center; }
                        }
                        Rectangle { width: 110px;
                            Text { text: "节点/Sheet"; font-size: Theme.fs-tiny; color: Theme.text-secondary; vertical-alignment: center; }
                        }
                        Rectangle { width: 60px;
                            Text { text: "tablet(行×列)"; font-size: Theme.fs-tiny; color: Theme.text-secondary; vertical-alignment: center; }
                        }
                        Rectangle { width: 160px;
                            Text { text: "操作"; font-size: Theme.fs-tiny; color: Theme.text-secondary; vertical-alignment: center; }
                        }
                        Rectangle { width: 60px;
                            Text { text: "Excel(行×列)"; font-size: Theme.fs-tiny; color: Theme.text-secondary; vertical-alignment: center; }
                        }
                    }
                }
                ScrollView {
                    VerticalLayout { spacing: 1px;
                        for row[i] in root.rows : Rectangle { height: Theme.row-h;
                            HorizontalLayout { padding-left: 4px; spacing: 4px;
                                Rectangle { width: 16px; height: 16px;
                                    background: row.checked ? Theme.bg-row-selected : Theme.bg-panel;
                                    border-color: Theme.border-light; border-width: 1px;
                                    Text { text: " "; font-size: Theme.fs-tiny; vertical-alignment: center; horizontal-alignment: center; }
                                }
                                Text { text: row.group + "/" + row.node; font-size: Theme.fs-small;
                                    color: Theme.text-primary; vertical-alignment: center; width: 170px; }
                                // tablet diff
                                if row.left_only : Rectangle { width: 60px;
                                    Text { text: "(新)"; font-size: Theme.fs-tiny; color: Theme.text-primary; vertical-alignment: center; }
                                }
                                if !row.left_only : Rectangle { width: 60px;
                                    Text {
                                        text: row.has_diff ? (row.la > 0 ? "+" + (row.la) : row.lm > 0 ? "*" + (row.lm) : "=") : "=";
                                        font-size: Theme.fs-tiny; vertical-alignment: center;
                                        color: Theme.text-primary;
                                    }
                                }
                                // Actions
                                Rectangle { width: 160px; HorizontalLayout { spacing: 2px;
                                    // → ← (match/tail-diff)
                                    if row.hdr_match || row.tbl_more_cols || row.xlsx_more_cols : Rectangle {
                                        border-color: Theme.text-primary;
                                        border-width: 1px; border-radius: 2px; width: 42px; height: 18px;
                                        background: transparent;
                                        Text { text: "数据→"; font-size: Theme.fs-tiny;
                                            color: Theme.text-primary;
                                            vertical-alignment: center; horizontal-alignment: center; }
                                        TouchArea { clicked => { root.action(i, 1); } }
                                    }
                                    if row.hdr_match || row.tbl_more_cols || row.xlsx_more_cols : Rectangle {
                                        border-color: Theme.text-primary;
                                        border-width: 1px; border-radius: 2px; width: 42px; height: 18px;
                                        background: transparent;
                                        Text { text: "←数据"; font-size: Theme.fs-tiny;
                                            color: Theme.text-primary;
                                            vertical-alignment: center; horizontal-alignment: center; }
                                        TouchArea { clicked => { root.action(i, 2); } }
                                    }
                                    // 补列→ (tablet has more cols)
                                    if row.tbl_more_cols : Rectangle {
                                        border-color: Theme.text-primary; border-width: 1px; border-radius: 2px;
                                        width: 42px; height: 18px; background: transparent;
                                        Text { text: "补列→"; font-size: Theme.fs-tiny;
                                            color: Theme.text-primary;
                                            vertical-alignment: center; horizontal-alignment: center; }
                                        TouchArea { clicked => { root.action(i, 3); } }
                                    }
                                    // ←补列 (xlsx has more cols)
                                    if row.xlsx_more_cols : Rectangle {
                                        border-color: Theme.text-primary; border-width: 1px; border-radius: 2px;
                                        width: 42px; height: 18px; background: transparent;
                                        Text { text: "←补列"; font-size: Theme.fs-tiny;
                                            color: Theme.text-primary;
                                            vertical-alignment: center; horizontal-alignment: center; }
                                        TouchArea { clicked => { root.action(i, 4); } }
                                    }
                                    // 强制→/← (mismatch)
                                    if row.hdr_mismatch : Rectangle {
                                        border-color: Theme.text-primary; border-width: 1px; border-radius: 2px;
                                        width: 46px; height: 18px; background: transparent;
                                        Text { text: "强制→"; font-size: Theme.fs-tiny; color: Theme.text-primary;
                                            vertical-alignment: center; horizontal-alignment: center; }
                                        TouchArea { clicked => { root.action(i, 5); } }
                                    }
                                    if row.hdr_mismatch : Rectangle {
                                        border-color: Theme.text-primary; border-width: 1px; border-radius: 2px;
                                        width: 46px; height: 18px; background: transparent;
                                        Text { text: "←强制"; font-size: Theme.fs-tiny; color: Theme.text-primary;
                                            vertical-alignment: center; horizontal-alignment: center; }
                                        TouchArea { clicked => { root.action(i, 6); } }
                                    }
                                    // 创建→ (only left)
                                    if row.left_only : Rectangle {
                                        border-color: Theme.text-primary; border-width: 1px; border-radius: 2px;
                                        width: 46px; height: 18px; background: transparent;
                                        Text { text: "创建→"; font-size: Theme.fs-tiny; color: Theme.text-primary;
                                            vertical-alignment: center; horizontal-alignment: center; }
                                        TouchArea { clicked => { root.action(i, 7); } }
                                    }
                                    // ←导入 (only right, valid)
                                    if row.right_only && !row.blocked : Rectangle {
                                        border-color: Theme.text-primary; border-width: 1px; border-radius: 2px;
                                        width: 46px; height: 18px; background: transparent;
                                        Text { text: "←导入"; font-size: Theme.fs-tiny; color: Theme.text-primary;
                                            vertical-alignment: center; horizontal-alignment: center; }
                                        TouchArea { clicked => { root.action(i, 8); } }
                                    }
                                    if row.blocked : Rectangle { width: 28px; height: 18px;
                                        Text { text: "⛔"; font-size: Theme.fs-tiny; color: Theme.text-error; vertical-alignment: center; horizontal-alignment: center; }
                                    }
                                }}
                                // Excel diff
                                if row.right_only : Rectangle { width: 60px;
                                    Text { text: "(新)"; font-size: Theme.fs-tiny; color: Theme.text-primary; vertical-alignment: center; }
                                }
                                if !row.right_only : Rectangle { width: 60px;
                                    Text {
                                        text: row.has_diff ? (row.ra > 0 ? "+" + (row.ra) : row.rm > 0 ? "*" + (row.rm) : "=") : "=";
                                        font-size: Theme.fs-tiny; vertical-alignment: center;
                                        color: Theme.text-primary;
                                    }
                                }
                                if row.blocked : Text { text: row.blocked-reason; font-size: Theme.fs-tiny; color: Theme.text-error; vertical-alignment: center; width: 120px; }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                    }
                }
            }
        }
    }
}
