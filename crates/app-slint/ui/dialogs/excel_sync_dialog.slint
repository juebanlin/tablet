import { Theme } from "../theme.slint";
import { DialogChrome } from "dialog_chrome.slint";
import { ScrollView } from "std-widgets.slint";

export struct EsRow {
    group: string,
    node: string,
    checked: bool,
    la: int, lr: int, lm: int,
    left_only: bool,
    ra: int, rr: int, rm: int,
    right_sheet: string,
    right_xlsx: string,
    right_only: bool,
    blocked: bool,
    blocked_reason: string,
    hdr_match: bool,
    hdr_tail: bool,
    hdr_mismatch: bool,
}

export component ExcelSyncDialog inherits Rectangle {
    in property <bool> open: false;
    in property <[EsRow]> rows;

    callback close();
    callback refresh();
    callback action(int, int);

    width: 100%; height: 100%;
    visible: root.open;

    if root.open : DialogChrome {
        title: "Excel 同步";
        dialog-w: 900px;
        dialog-h: 550px;
        primary-text: "刷新";
        cancel-text: "关闭";
        primary-clicked => { root.refresh(); }
        cancel-clicked => { root.close(); }
        scrim-clicked => { root.close(); }

        // Content: dual-list rows
        Rectangle { vertical-stretch: 1;
            VerticalLayout { spacing: 0; padding: 4px;
                // Column headers
                Rectangle { height: 22px; background: Theme.bg-header;
                    HorizontalLayout { padding-left: 4px; spacing: 4px;
                        Rectangle { width: 16px; }
                        Rectangle { width: 60px;
                            Text { text: "组名"; font-size: Theme.fs-tiny; color: Theme.text-secondary; vertical-alignment: center; }
                        }
                        Rectangle { width: 100px;
                            Text { text: "tablet 节点"; font-size: Theme.fs-tiny; color: Theme.text-secondary; vertical-alignment: center; }
                        }
                        Rectangle { width: 60px;
                            Text { text: "差异"; font-size: Theme.fs-tiny; color: Theme.text-secondary; vertical-alignment: center; }
                        }
                        Rectangle { width: 20px; }
                        Rectangle { width: 100px;
                            Text { text: "xlsx sheet"; font-size: Theme.fs-tiny; color: Theme.text-secondary; vertical-alignment: center; }
                        }
                        Rectangle { width: 60px;
                            Text { text: "差异"; font-size: Theme.fs-tiny; color: Theme.text-secondary; vertical-alignment: center; }
                        }
                    }
                }
                ScrollView {
                    VerticalLayout { spacing: 1px;
                        for row[i] in root.rows : Rectangle { height: Theme.row-h;
                            HorizontalLayout { padding-left: 4px; spacing: 4px;
                                // checkbox
                                Rectangle { width: 16px; height: 16px;
                                    background: row.checked ? Theme.bg-row-selected : Theme.bg-panel;
                                    border-color: Theme.border-light; border-width: 1px;
                                    Text { text: " "; font-size: Theme.fs-tiny; vertical-alignment: center; horizontal-alignment: center; }
                                }
                                // group
                                Text { text: row.group; font-size: Theme.fs-tiny; color: Theme.text-secondary; vertical-alignment: center; width: 60px; }
                                // node name
                                Text { text: row.node; font-size: Theme.fs-small; color: Theme.text-primary; vertical-alignment: center; width: 100px; }
                                // left diff
                                if row.la > 0 : Text { text: "+" + (row.la); font-size: Theme.fs-tiny; color: Theme.text-success; vertical-alignment: center; width: 40px; }
                                if row.la == 0 : Rectangle { width: 40px; }
                                if row.lm > 0 : Text { text: "*" + (row.lm); font-size: Theme.fs-tiny; color: Theme.text-secondary; vertical-alignment: center; width: 40px; }
                                if row.lm == 0 : Rectangle { width: 40px; }
                                if row.left_only : Text { text: "(仅左)"; font-size: Theme.fs-tiny; color: Theme.text-info; vertical-alignment: center; width: 40px; }
                                // spacer
                                Rectangle { width: 20px; }
                                // right sheet
                                if row.blocked : Text { text: "x"; font-size: Theme.fs-small; color: Theme.text-error; vertical-alignment: center; width: 16px; }
                                if !row.blocked : Rectangle { width: 16px; }
                                Text { text: row.right_sheet; font-size: Theme.fs-small; color: Theme.text-primary; vertical-alignment: center; width: 100px; }
                                // right diff
                                if row.ra > 0 : Text { text: "+" + (row.ra); font-size: Theme.fs-tiny; color: Theme.text-success; vertical-alignment: center; width: 40px; }
                                if row.ra == 0 : Rectangle { width: 40px; }
                                if row.rm > 0 : Text { text: "*" + (row.rm); font-size: Theme.fs-tiny; color: Theme.text-secondary; vertical-alignment: center; width: 40px; }
                                if row.rm == 0 : Rectangle { width: 40px; }
                                if row.right_only : Text { text: "(仅右)"; font-size: Theme.fs-tiny; color: Theme.text-info; vertical-alignment: center; width: 40px; }
                                if row.blocked : Text { text: row.blocked-reason; font-size: Theme.fs-tiny; color: Theme.text-error; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                    }
                }
            }
        }
    }
}
