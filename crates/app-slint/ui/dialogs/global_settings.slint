// 全局设置对话框：UI设置 / 分隔符 / 导出设置 3 tab。

import { Theme } from "../theme.slint";
import { ModifiedField } from "../components/modified_field.slint";
import { SepRow } from "../components/sep_row.slint";
import { DialogChrome } from "dialog_chrome.slint";
import { Button, LineEdit, ScrollView, CheckBox, ComboBox } from "std-widgets.slint";

// Tab segmented bar：UI设置 / 分隔符 / 导出设置
component TabBar inherits Rectangle {
    in property <int> current: 0;
    callback changed(int);

    height: 32px;
    background: Theme.bg-toolbar;
    border-color: Theme.border-light;
    border-width: 1px;

    HorizontalLayout {
        spacing: 0;
        padding-left: Theme.sp-3;
        padding-top: 4px;
        alignment: start;
        Rectangle {
            width: 96px;
            background: root.current == 0 ? Theme.bg-row-selected : transparent;
            Text {
                text: "UI设置";
                font-size: Theme.fs-normal;
                color: Theme.text-primary;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            TouchArea { clicked => { root.changed(0); } }
        }
        Rectangle {
            width: 96px;
            background: root.current == 1 ? Theme.bg-row-selected : transparent;
            Text {
                text: "分隔符模板";
                font-size: Theme.fs-normal;
                color: Theme.text-primary;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            TouchArea { clicked => { root.changed(1); } }
        }
        Rectangle {
            width: 96px;
            background: root.current == 2 ? Theme.bg-row-selected : transparent;
            Text {
                text: "导出模板";
                font-size: Theme.fs-normal;
                color: Theme.text-primary;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            TouchArea { clicked => { root.changed(2); } }
        }
    }
}


export component GlobalSettingsDialog inherits Rectangle {
    in property <bool> open: false;
    in property <int> tab: 0;
    // 属性名 = AppWindow 上的 `gs-*` 去掉 `gs-` 前缀，app.slint 那边一比一机械绑定。
    // `*-modified` = 「和打开对话框那一刻的 tablet.toml 不一样吗」，后端按 current_snapshot
    // 算好推上来（@02.26.6）。这里不做比较 —— `None` 与 `Some(默认值)` 在渲染值上看不出来。
    // 枚举选项列表（由后端推送）
    in property <[string]> log-level-options;
    in property <[string]> picker-trigger-options;
    in property <[string]> ref-picker-strategy-options;
    in property <[string]> encoding-options;
    in property <[string]> line-ending-options;
    in property <[string]> json-empty-as-options;
    in property <[string]> xml-empty-as-options;
    in property <[string]> cpp-json-lib-options;
    // UI 设置
    in-out property <bool> ui-auto-commit-on-blur;
    in property <bool> ui-auto-commit-on-blur-modified: false;
    in-out property <bool> ui-realtime-validate;
    in property <bool> ui-realtime-validate-modified: false;
    in-out property <bool> ui-show-meta-id;
    in property <bool> ui-show-meta-id-modified: false;
    in-out property <bool> ui-constant-ref-allowed;
    in property <bool> ui-constant-ref-allowed-modified: false;
    in-out property <int> ui-log-level-index;
    in property <bool> ui-log-level-modified: false;
    in-out property <int> ui-ref-picker-strategy-index;
    in property <bool> ui-ref-picker-strategy-modified: false;
    in-out property <int> ui-picker-trigger-header-index;
    in property <bool> ui-picker-trigger-header-modified: false;
    in-out property <int> ui-picker-trigger-data-index;
    in property <bool> ui-picker-trigger-data-modified: false;
    // 分隔符（25 个）
    in-out property <string> sep-tuple2;
    in property <bool> sep-tuple2-modified: false;
    in-out property <string> sep-tuple3;
    in property <bool> sep-tuple3-modified: false;
    in-out property <string> sep-tuple4;
    in property <bool> sep-tuple4-modified: false;
    in-out property <string> sep-list;
    in property <bool> sep-list-modified: false;
    in-out property <string> sep-set;
    in property <bool> sep-set-modified: false;
    in-out property <string> sep-map-kv;
    in property <bool> sep-map-kv-modified: false;
    in-out property <string> sep-map-entry;
    in property <bool> sep-map-entry-modified: false;
    in-out property <string> sep-lt2-tuple;
    in property <bool> sep-lt2-tuple-modified: false;
    in-out property <string> sep-lt2-list;
    in property <bool> sep-lt2-list-modified: false;
    in-out property <string> sep-lt3-tuple;
    in property <bool> sep-lt3-tuple-modified: false;
    in-out property <string> sep-lt3-list;
    in property <bool> sep-lt3-list-modified: false;
    in-out property <string> sep-lt4-tuple;
    in property <bool> sep-lt4-tuple-modified: false;
    in-out property <string> sep-lt4-list;
    in property <bool> sep-lt4-list-modified: false;
    in-out property <string> sep-mt2-kv;
    in property <bool> sep-mt2-kv-modified: false;
    in-out property <string> sep-mt2-tuple;
    in property <bool> sep-mt2-tuple-modified: false;
    in-out property <string> sep-mt2-entry;
    in property <bool> sep-mt2-entry-modified: false;
    in-out property <string> sep-mt3-kv;
    in property <bool> sep-mt3-kv-modified: false;
    in-out property <string> sep-mt3-tuple;
    in property <bool> sep-mt3-tuple-modified: false;
    in-out property <string> sep-mt3-entry;
    in property <bool> sep-mt3-entry-modified: false;
    in-out property <string> sep-mt4-kv;
    in property <bool> sep-mt4-kv-modified: false;
    in-out property <string> sep-mt4-tuple;
    in property <bool> sep-mt4-tuple-modified: false;
    in-out property <string> sep-mt4-entry;
    in property <bool> sep-mt4-entry-modified: false;
    in-out property <string> sep-ml-kv;
    in property <bool> sep-ml-kv-modified: false;
    in-out property <string> sep-ml-item;
    in property <bool> sep-ml-item-modified: false;
    in-out property <string> sep-ml-entry;
    in property <bool> sep-ml-entry-modified: false;
    // 导出设置
    in-out property <int> export-encoding-index;
    in property <bool> export-encoding-modified: false;
    in-out property <int> export-line-ending-index;
    in property <bool> export-line-ending-modified: false;
    in-out property <int> export-json-empty-as-index;
    in property <bool> export-json-empty-as-modified: false;
    in-out property <int> export-xml-empty-as-index;
    in property <bool> export-xml-empty-as-modified: false;
    in-out property <int> export-cpp-json-lib-index;
    in property <bool> export-cpp-json-lib-modified: false;
    in-out property <string> export-server-data-output;
    in property <bool> export-server-data-output-modified: false;
    in-out property <string> export-java-package;
    in property <bool> export-java-package-modified: false;
    in-out property <string> export-java-code-output;
    in property <bool> export-java-code-output-modified: false;
    in-out property <string> export-go-package;
    in property <bool> export-go-package-modified: false;
    in-out property <string> export-go-code-output;
    in property <bool> export-go-code-output-modified: false;
    in-out property <string> export-cpp-namespace;
    in property <bool> export-cpp-namespace-modified: false;
    in-out property <string> export-cpp-code-output;
    in property <bool> export-cpp-code-output-modified: false;
    in-out property <string> export-csharp-dotnet-namespace;
    in property <bool> export-csharp-dotnet-namespace-modified: false;
    in-out property <string> export-csharp-dotnet-code-output;
    in property <bool> export-csharp-dotnet-code-output-modified: false;
    in-out property <string> export-typescript-server-code-output;
    in property <bool> export-typescript-server-code-output-modified: false;
    in-out property <string> export-lua-output;
    in property <bool> export-lua-output-modified: false;
    in-out property <string> export-gdscript-output;
    in property <bool> export-gdscript-output-modified: false;
    in-out property <string> export-typescript-client-output;
    in property <bool> export-typescript-client-output-modified: false;
    in-out property <string> export-csharp-unity-namespace;
    in property <bool> export-csharp-unity-namespace-modified: false;
    in-out property <string> export-csharp-unity-code-output;
    in property <bool> export-csharp-unity-code-output-modified: false;
    in-out property <string> export-csharp-godot-namespace;
    in property <bool> export-csharp-godot-namespace-modified: false;
    in-out property <string> export-csharp-godot-code-output;
    in property <bool> export-csharp-godot-code-output-modified: false;
    in-out property <bool> export-cpp-custom-regions;
    in property <bool> export-cpp-custom-regions-modified: false;
    in-out property <bool> export-java-lombok;
    in property <bool> export-java-lombok-modified: false;
    in-out property <bool> export-java-custom-regions;
    in property <bool> export-java-custom-regions-modified: false;
    in-out property <bool> export-go-custom-regions;
    in property <bool> export-go-custom-regions-modified: false;
    in-out property <bool> export-csharp-dotnet-custom-regions;
    in property <bool> export-csharp-dotnet-custom-regions-modified: false;
    in-out property <bool> export-csharp-unity-custom-regions;
    in property <bool> export-csharp-unity-custom-regions-modified: false;
    in-out property <bool> export-csharp-godot-custom-regions;
    in property <bool> export-csharp-godot-custom-regions-modified: false;
    callback tab-changed(int);
    callback ui-field-edited(string, string);
    callback sep-edited(string, string);
    callback export-field-edited(string, string);
    callback ui-revert(string);
    callback sep-revert(string);
    callback export-revert(string);
    callback reset-clicked();
    callback confirm();
    callback cancel();

    visible: root.open;
    width: 100%;
    height: 100%;

    DialogChrome {
        title: "全局设置";
        dialog-w: 800px;
        dialog-h: 600px;
        primary-text: "确定";
        primary-enabled: true;
        primary-clicked => { root.confirm(); }
        cancel-clicked => { root.cancel(); }
        scrim-clicked => { root.cancel(); }
        show-secondary: true;
        secondary-text: "使用默认值";
        default-enabled: true;
        secondary-clicked => { root.reset-clicked(); }
        // 刻意**不做**页面级「全部还原」：全局设置的「取消」已经是它了（区别只是关不关窗）。
        // 反悔的入口是每个字段右侧的还原按钮（@02.26.6）。

        VerticalLayout {
            spacing: 0;
            padding: 0;

            TabBar {
                current: root.tab;
                changed(i) => { root.tab-changed(i); }
            }

            // UI设置 tab
            if root.tab == 0: ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    padding: Theme.sp-4;
                    spacing: Theme.sp-3;

                    Text { text: "编辑行为"; color: Theme.text-secondary; font-size: Theme.fs-small; }
                    HorizontalLayout {
                        spacing: Theme.sp-3;
                        ModifiedField {
                            modified: root.ui-auto-commit-on-blur-modified;
                            revert => { root.ui-revert("auto_commit_on_blur"); }
                            CheckBox {
                                text: "失焦自动提交";
                                checked <=> root.ui-auto-commit-on-blur;
                                toggled => { root.ui-field-edited("auto_commit_on_blur", root.ui-auto-commit-on-blur ? "true" : "false"); }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.sp-3;
                        ModifiedField {
                            modified: root.ui-realtime-validate-modified;
                            revert => { root.ui-revert("realtime_validate"); }
                            CheckBox {
                                text: "实时验证";
                                checked <=> root.ui-realtime-validate;
                                toggled => { root.ui-field-edited("realtime_validate", root.ui-realtime-validate ? "true" : "false"); }
                            }
                        }
                    }

                    Text { text: "选择器触发"; color: Theme.text-secondary; font-size: Theme.fs-small; }
                    HorizontalLayout {
                        spacing: Theme.sp-3;
                        alignment: start;
                        Text { text: "表头触发方式:"; width: 120px; vertical-alignment: center; color: Theme.text-primary; }
                        ModifiedField {
                            modified: root.ui-picker-trigger-header-modified;
                            revert => { root.ui-revert("picker_trigger_header"); }
                            ComboBox {
                                model: root.picker-trigger-options;
                                current-index <=> root.ui-picker-trigger-header-index;
                                width: 120px;
                                selected(s) => { root.ui-field-edited("picker_trigger_header", s); }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.sp-3;
                        alignment: start;
                        Text { text: "数据区触发方式:"; width: 120px; vertical-alignment: center; color: Theme.text-primary; }
                        ModifiedField {
                            modified: root.ui-picker-trigger-data-modified;
                            revert => { root.ui-revert("picker_trigger_data"); }
                            ComboBox {
                                model: root.picker-trigger-options;
                                current-index <=> root.ui-picker-trigger-data-index;
                                width: 120px;
                                selected(s) => { root.ui-field-edited("picker_trigger_data", s); }
                            }
                        }
                    }

                    Text { text: "显示选项"; color: Theme.text-secondary; font-size: Theme.fs-small; }
                    HorizontalLayout {
                        spacing: Theme.sp-3;
                        ModifiedField {
                            modified: root.ui-show-meta-id-modified;
                            revert => { root.ui-revert("show_meta_id"); }
                            CheckBox {
                                text: "显示元数据 ID";
                                checked <=> root.ui-show-meta-id;
                                toggled => { root.ui-field-edited("show_meta_id", root.ui-show-meta-id ? "true" : "false"); }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.sp-3;
                        ModifiedField {
                            modified: root.ui-constant-ref-allowed-modified;
                            revert => { root.ui-revert("constant_ref_allowed"); }
                            CheckBox {
                                text: "允许常量表引用";
                                checked <=> root.ui-constant-ref-allowed;
                                toggled => { root.ui-field-edited("constant_ref_allowed", root.ui-constant-ref-allowed ? "true" : "false"); }
                            }
                        }
                    }

                    Text { text: "引用选择器"; color: Theme.text-secondary; font-size: Theme.fs-small; }
                    HorizontalLayout {
                        spacing: Theme.sp-3;
                        alignment: start;
                        Text { text: "默认策略:"; width: 120px; vertical-alignment: center; color: Theme.text-primary; }
                        ModifiedField {
                            modified: root.ui-ref-picker-strategy-modified;
                            revert => { root.ui-revert("ref_picker_strategy"); }
                            ComboBox {
                                model: root.ref-picker-strategy-options;
                                current-index <=> root.ui-ref-picker-strategy-index;
                                width: 120px;
                                selected(s) => { root.ui-field-edited("ref_picker_strategy", s); }
                            }
                        }
                    }

                    Text { text: "日志"; color: Theme.text-secondary; font-size: Theme.fs-small; }
                    HorizontalLayout {
                        spacing: Theme.sp-3;
                        alignment: start;
                        Text { text: "日志级别:"; width: 120px; vertical-alignment: center; color: Theme.text-primary; }
                        ModifiedField {
                            modified: root.ui-log-level-modified;
                            revert => { root.ui-revert("log_level"); }
                            ComboBox {
                                model: root.log-level-options;
                                current-index <=> root.ui-log-level-index;
                                width: 120px;
                                selected(s) => { root.ui-field-edited("log_level", s); }
                            }
                        }
                    }

                    Text {
                        text: "提示：UI 配置修改后立即生效并写入 tablet.toml。";
                        color: Theme.text-secondary;
                        font-size: Theme.fs-tiny;
                        wrap: word-wrap;
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }

            // 分隔符 tab（复用项目设置的布局）
            if root.tab == 1: ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    padding: Theme.sp-4;
                    spacing: Theme.sp-3;

                    Text { text: "基础"; color: Theme.text-secondary; font-size: Theme.fs-small; }
                    SepRow {
                        l1: "Tuple2"; v1 <=> root.sep-tuple2;
                        l2: "Tuple3"; v2 <=> root.sep-tuple3;
                        l3: "Tuple4"; v3 <=> root.sep-tuple4;
                        show2: true; show3: true;
                        m1: root.sep-tuple2-modified;
                        revert1 => { root.sep-revert("Tuple2"); }
                        m2: root.sep-tuple3-modified;
                        revert2 => { root.sep-revert("Tuple3"); }
                        m3: root.sep-tuple4-modified;
                        revert3 => { root.sep-revert("Tuple4"); }
                        edited1(s) => { root.sep-edited("Tuple2", s); }
                        edited2(s) => { root.sep-edited("Tuple3", s); }
                        edited3(s) => { root.sep-edited("Tuple4", s); }
                    }
                    SepRow {
                        l1: "List"; v1 <=> root.sep-list;
                        l2: "Set"; v2 <=> root.sep-set;
                        show2: true; show3: false;
                        m1: root.sep-list-modified;
                        revert1 => { root.sep-revert("List"); }
                        m2: root.sep-set-modified;
                        revert2 => { root.sep-revert("Set"); }
                        edited1(s) => { root.sep-edited("List", s); }
                        edited2(s) => { root.sep-edited("Set", s); }
                    }

                    Text { text: "Map"; color: Theme.text-secondary; font-size: Theme.fs-small; }
                    SepRow {
                        l1: "Map.kv"; v1 <=> root.sep-map-kv;
                        l2: "Map.entry"; v2 <=> root.sep-map-entry;
                        show2: true; show3: false;
                        m1: root.sep-map-kv-modified;
                        revert1 => { root.sep-revert("Map.kv"); }
                        m2: root.sep-map-entry-modified;
                        revert2 => { root.sep-revert("Map.entry"); }
                        edited1(s) => { root.sep-edited("Map.kv", s); }
                        edited2(s) => { root.sep-edited("Map.entry", s); }
                    }

                    Text { text: "List<TupleN>"; color: Theme.text-secondary; font-size: Theme.fs-small; }
                    SepRow {
                        l1: "List_Tuple2.tuple"; v1 <=> root.sep-lt2-tuple;
                        l2: "List_Tuple2.list"; v2 <=> root.sep-lt2-list;
                        show2: true; show3: false;
                        m1: root.sep-lt2-tuple-modified;
                        revert1 => { root.sep-revert("List_Tuple2.tuple"); }
                        m2: root.sep-lt2-list-modified;
                        revert2 => { root.sep-revert("List_Tuple2.list"); }
                        edited1(s) => { root.sep-edited("List_Tuple2.tuple", s); }
                        edited2(s) => { root.sep-edited("List_Tuple2.list", s); }
                    }
                    SepRow {
                        l1: "List_Tuple3.tuple"; v1 <=> root.sep-lt3-tuple;
                        l2: "List_Tuple3.list"; v2 <=> root.sep-lt3-list;
                        show2: true; show3: false;
                        m1: root.sep-lt3-tuple-modified;
                        revert1 => { root.sep-revert("List_Tuple3.tuple"); }
                        m2: root.sep-lt3-list-modified;
                        revert2 => { root.sep-revert("List_Tuple3.list"); }
                        edited1(s) => { root.sep-edited("List_Tuple3.tuple", s); }
                        edited2(s) => { root.sep-edited("List_Tuple3.list", s); }
                    }
                    SepRow {
                        l1: "List_Tuple4.tuple"; v1 <=> root.sep-lt4-tuple;
                        l2: "List_Tuple4.list"; v2 <=> root.sep-lt4-list;
                        show2: true; show3: false;
                        m1: root.sep-lt4-tuple-modified;
                        revert1 => { root.sep-revert("List_Tuple4.tuple"); }
                        m2: root.sep-lt4-list-modified;
                        revert2 => { root.sep-revert("List_Tuple4.list"); }
                        edited1(s) => { root.sep-edited("List_Tuple4.tuple", s); }
                        edited2(s) => { root.sep-edited("List_Tuple4.list", s); }
                    }

                    Text { text: "Map<*,TupleN>"; color: Theme.text-secondary; font-size: Theme.fs-small; }
                    SepRow {
                        l1: "Map_Tuple2.kv"; v1 <=> root.sep-mt2-kv;
                        l2: "Map_Tuple2.tuple"; v2 <=> root.sep-mt2-tuple;
                        l3: "Map_Tuple2.entry"; v3 <=> root.sep-mt2-entry;
                        show2: true; show3: true;
                        m1: root.sep-mt2-kv-modified;
                        revert1 => { root.sep-revert("Map_Tuple2.kv"); }
                        m2: root.sep-mt2-tuple-modified;
                        revert2 => { root.sep-revert("Map_Tuple2.tuple"); }
                        m3: root.sep-mt2-entry-modified;
                        revert3 => { root.sep-revert("Map_Tuple2.entry"); }
                        edited1(s) => { root.sep-edited("Map_Tuple2.kv", s); }
                        edited2(s) => { root.sep-edited("Map_Tuple2.tuple", s); }
                        edited3(s) => { root.sep-edited("Map_Tuple2.entry", s); }
                    }
                    SepRow {
                        l1: "Map_Tuple3.kv"; v1 <=> root.sep-mt3-kv;
                        l2: "Map_Tuple3.tuple"; v2 <=> root.sep-mt3-tuple;
                        l3: "Map_Tuple3.entry"; v3 <=> root.sep-mt3-entry;
                        show2: true; show3: true;
                        m1: root.sep-mt3-kv-modified;
                        revert1 => { root.sep-revert("Map_Tuple3.kv"); }
                        m2: root.sep-mt3-tuple-modified;
                        revert2 => { root.sep-revert("Map_Tuple3.tuple"); }
                        m3: root.sep-mt3-entry-modified;
                        revert3 => { root.sep-revert("Map_Tuple3.entry"); }
                        edited1(s) => { root.sep-edited("Map_Tuple3.kv", s); }
                        edited2(s) => { root.sep-edited("Map_Tuple3.tuple", s); }
                        edited3(s) => { root.sep-edited("Map_Tuple3.entry", s); }
                    }
                    SepRow {
                        l1: "Map_Tuple4.kv"; v1 <=> root.sep-mt4-kv;
                        l2: "Map_Tuple4.tuple"; v2 <=> root.sep-mt4-tuple;
                        l3: "Map_Tuple4.entry"; v3 <=> root.sep-mt4-entry;
                        show2: true; show3: true;
                        m1: root.sep-mt4-kv-modified;
                        revert1 => { root.sep-revert("Map_Tuple4.kv"); }
                        m2: root.sep-mt4-tuple-modified;
                        revert2 => { root.sep-revert("Map_Tuple4.tuple"); }
                        m3: root.sep-mt4-entry-modified;
                        revert3 => { root.sep-revert("Map_Tuple4.entry"); }
                        edited1(s) => { root.sep-edited("Map_Tuple4.kv", s); }
                        edited2(s) => { root.sep-edited("Map_Tuple4.tuple", s); }
                        edited3(s) => { root.sep-edited("Map_Tuple4.entry", s); }
                    }

                    Text { text: "Map<*,List>"; color: Theme.text-secondary; font-size: Theme.fs-small; }
                    SepRow {
                        l1: "Map_List.kv"; v1 <=> root.sep-ml-kv;
                        l2: "Map_List.item"; v2 <=> root.sep-ml-item;
                        l3: "Map_List.entry"; v3 <=> root.sep-ml-entry;
                        show2: true; show3: true;
                        m1: root.sep-ml-kv-modified;
                        revert1 => { root.sep-revert("Map_List.kv"); }
                        m2: root.sep-ml-item-modified;
                        revert2 => { root.sep-revert("Map_List.item"); }
                        m3: root.sep-ml-entry-modified;
                        revert3 => { root.sep-revert("Map_List.entry"); }
                        edited1(s) => { root.sep-edited("Map_List.kv", s); }
                        edited2(s) => { root.sep-edited("Map_List.item", s); }
                        edited3(s) => { root.sep-edited("Map_List.entry", s); }
                    }
                }
            }

