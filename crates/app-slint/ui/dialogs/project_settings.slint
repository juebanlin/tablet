// 项目设置对话框：身份（id/name/category/version）+ 分隔符（25 leaves）2 tab。

import { Theme } from "../theme.slint";
import { DialogChrome } from "dialog_chrome.slint";
import { Button, LineEdit, ScrollView, ComboBox } from "std-widgets.slint";

// Tab segmented bar：身份 / 分隔符 / 导出设置
component TabBar inherits Rectangle {
    in property <int> current: 0;
    callback changed(int);

    height: 32px;
    background: Theme.bg-toolbar;
    border-color: Theme.border-light;
    border-width: 1px;

    HorizontalLayout {
        spacing: 0;
        padding-left: Theme.sp-3;
        padding-top: 4px;
        alignment: start;
        Rectangle {
            width: 96px;
            background: root.current == 0 ? Theme.bg-row-selected : transparent;
            Text {
                text: "身份";
                font-size: Theme.fs-normal;
                color: Theme.text-primary;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            TouchArea { clicked => { root.changed(0); } }
        }
        Rectangle {
            width: 96px;
            background: root.current == 1 ? Theme.bg-row-selected : transparent;
            Text {
                text: "分隔符";
                font-size: Theme.fs-normal;
                color: Theme.text-primary;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            TouchArea { clicked => { root.changed(1); } }
        }
        Rectangle {
            width: 96px;
            background: root.current == 2 ? Theme.bg-row-selected : transparent;
            Text {
                text: "导出设置";
                font-size: Theme.fs-normal;
                color: Theme.text-primary;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            TouchArea { clicked => { root.changed(2); } }
        }
    }
}

// 单条紧凑分隔符行：[label][input][label][input]...（label 70px，input 64px）
component SepRow inherits HorizontalLayout {
    in property <string> l1;
    in-out property <string> v1;
    in property <string> l2;
    in-out property <string> v2;
    in property <string> l3;
    in-out property <string> v3;
    in property <bool> show2: true;
    in property <bool> show3: false;
    callback edited1(string);
    callback edited2(string);
    callback edited3(string);

    spacing: Theme.sp-2;
    alignment: start;

    Text {
        text: root.l1; width: 96px;
        color: Theme.text-primary;
        vertical-alignment: center;
        horizontal-alignment: end;
    }
    LineEdit {
        text <=> root.v1;
        width: 56px;
        edited(s) => { root.edited1(s); }
    }
    if root.show2: Text {
        text: root.l2; width: 96px;
        color: Theme.text-primary;
        vertical-alignment: center;
        horizontal-alignment: end;
    }
    if root.show2: LineEdit {
        text <=> root.v2;
        width: 56px;
        edited(s) => { root.edited2(s); }
    }
    if root.show3: Text {
        text: root.l3; width: 96px;
        color: Theme.text-primary;
        vertical-alignment: center;
        horizontal-alignment: end;
    }
    if root.show3: LineEdit {
        text <=> root.v3;
        width: 56px;
        edited(s) => { root.edited3(s); }
    }
}

export component ProjectSettingsDialog inherits Rectangle {
    in property <bool> open: false;
    in property <int> tab: 0;
    in-out property <bool> identity-tab-modified: false;
    in-out property <bool> sep-tab-modified: false;
    in-out property <bool> export-tab-modified: false;

    // 身份 buf
    in-out property <string> id-buf;
    in-out property <string> name-buf;
    in-out property <string> category-buf;
    in-out property <string> version-buf;
    in property <string> id-error;
    in property <bool> can-confirm: true;
    // id 是否可编辑：仅未落盘项目（克隆 / 新建）为 true；已存盘项目 id 固定。
    in property <bool> id-editable: false;
    // 分隔符 buf —— 25 个叶子
    in-out property <string> sep-tuple2;
    in-out property <string> sep-tuple3;
    in-out property <string> sep-tuple4;
    in-out property <string> sep-list;
    in-out property <string> sep-set;
    in-out property <string> sep-map-kv;
    in-out property <string> sep-map-entry;
    in-out property <string> sep-lt2-tuple;
    in-out property <string> sep-lt2-list;
    in-out property <string> sep-lt3-tuple;
    in-out property <string> sep-lt3-list;
    in-out property <string> sep-lt4-tuple;
    in-out property <string> sep-lt4-list;
    in-out property <string> sep-mt2-kv;
    in-out property <string> sep-mt2-tuple;
    in-out property <string> sep-mt2-entry;
    in-out property <string> sep-mt3-kv;
    in-out property <string> sep-mt3-tuple;
    in-out property <string> sep-mt3-entry;
    in-out property <string> sep-mt4-kv;
    in-out property <string> sep-mt4-tuple;
    in-out property <string> sep-mt4-entry;
    in-out property <string> sep-ml-kv;
    in-out property <string> sep-ml-item;
    in-out property <string> sep-ml-entry;

    // 枚举选项列表（由后端推送）
    in property <[string]> ps-encoding-options;
    in property <[string]> ps-line-ending-options;
    in property <[string]> ps-json-empty-as-options;
    in property <[string]> ps-xml-empty-as-options;
    in property <[string]> ps-cpp-json-lib-options;

    // 导出设置 buf
    in-out property <int> ps-export-encoding-index;
    in-out property <int> ps-export-line-ending-index;
    in-out property <int> ps-export-json-empty-as-index;
    in-out property <int> ps-export-xml-empty-as-index;
    in-out property <string> ps-export-server-data-output;
    in-out property <string> ps-export-java-package;
    in-out property <string> ps-export-java-code-output;
    in-out property <string> ps-export-go-package;
    in-out property <string> ps-export-go-code-output;
    in-out property <string> ps-export-cpp-namespace;
    in-out property <string> ps-export-cpp-code-output;
    in-out property <int> ps-export-cpp-json-lib-index;
    in-out property <string> ps-export-csharp-dotnet-namespace;
    in-out property <string> ps-export-csharp-dotnet-code-output;
    in-out property <string> ps-export-typescript-server-code-output;
    in-out property <string> ps-export-lua-output;
    in-out property <string> ps-export-gdscript-output;
    in-out property <string> ps-export-typescript-client-output;
    in-out property <string> ps-export-csharp-unity-namespace;
    in-out property <string> ps-export-csharp-unity-code-output;
    in-out property <string> ps-export-csharp-godot-namespace;
    in-out property <string> ps-export-csharp-godot-code-output;

    callback tab-changed(int);
    callback id-edited(string);
    callback name-edited(string);
    callback category-edited(string);
    callback version-edited(string);
    /// (key, value) — key 与 # @sep 行 key 一致
    callback sep-edited(string, string);
    callback export-field-edited(string, string);
    callback reset-sep();
    callback reset-export();
    callback undo-clicked();
    callback confirm();
    callback cancel();

    visible: root.open;
    width: 100%;
    height: 100%;

    DialogChrome {
        title: "项目设置";
        dialog-w: 720px;
        dialog-h: 560px;
        primary-text: "确定";
        primary-enabled: root.can-confirm;
        primary-clicked => { root.confirm(); }
        cancel-clicked => { root.cancel(); }
        scrim-clicked => { root.cancel(); }
        show-secondary: root.tab == 1 || root.tab == 2;
        secondary-text: "恢复默认";
        secondary-clicked => {
            if root.tab == 1 {
                root.reset-sep();
            } else if root.tab == 2 {
                root.reset-export();
            }
        }
        show-third: true;
        third-text: "撤销改动";
        undo-enabled: root.tab == 0 ? root.identity-tab-modified : (root.tab == 1 ? root.sep-tab-modified : root.export-tab-modified);
        third-clicked => { root.undo-clicked(); }

        VerticalLayout {
            spacing: 0;
            padding: 0;

            TabBar {
                current: root.tab;
                changed(i) => { root.tab-changed(i); }
            }

            // 身份 tab —— 4 行表单
            if root.tab == 0: Rectangle {
                vertical-stretch: 1;
                VerticalLayout {
                    padding: Theme.sp-4;
                    spacing: Theme.sp-3;

                    HorizontalLayout {
                        spacing: Theme.sp-3;
                        alignment: stretch;
                        Text { text: "项目 ID:"; width: 96px; vertical-alignment: center; color: Theme.text-primary; }
                        LineEdit {
                            text <=> root.id-buf;
                            enabled: root.id-editable;
                            edited(s) => { root.id-edited(s); }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.sp-3;
                        alignment: stretch;
                        Text { text: "名称:"; width: 96px; vertical-alignment: center; color: Theme.text-primary; }
                        LineEdit {
                            text <=> root.name-buf;
                            edited(s) => { root.name-edited(s); }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.sp-3;
                        alignment: stretch;
                        Text { text: "分类:"; width: 96px; vertical-alignment: center; color: Theme.text-primary; }
                        LineEdit {
                            text <=> root.category-buf;
                            edited(s) => { root.category-edited(s); }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.sp-3;
                        alignment: stretch;
                        Text { text: "版本:"; width: 96px; vertical-alignment: center; color: Theme.text-primary; }
                        LineEdit {
                            text <=> root.version-buf;
                            edited(s) => { root.version-edited(s); }
                        }
                    }
                    if root.id-error != "": Text {
                        text: root.id-error;
                        color: Theme.text-error;
                        font-size: Theme.fs-tiny;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.id-editable
                            ? "提示：id 可改（项目尚未保存）；保存后 id 将固定，其它字段随项目保存落到 .tblschema。"
                            : "提示：已保存项目的 id 不可修改；其它字段随项目保存落到 .tblschema 元数据。";
                        color: Theme.text-secondary;
                        font-size: Theme.fs-tiny;
                        wrap: word-wrap;
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }

            // 分隔符 tab —— 紧凑分组
            if root.tab == 1: ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    padding: Theme.sp-4;
                    spacing: Theme.sp-3;

                    // 基础容器
                    Text { text: "基础"; color: Theme.text-secondary; font-size: Theme.fs-small; }
                    SepRow {
                        l1: "Tuple2"; v1 <=> root.sep-tuple2;
                        l2: "Tuple3"; v2 <=> root.sep-tuple3;
                        l3: "Tuple4"; v3 <=> root.sep-tuple4;
                        show2: true; show3: true;
                        edited1(s) => { root.sep-edited("Tuple2", s); }
                        edited2(s) => { root.sep-edited("Tuple3", s); }
                        edited3(s) => { root.sep-edited("Tuple4", s); }
                    }
                    SepRow {
                        l1: "List"; v1 <=> root.sep-list;
                        l2: "Set"; v2 <=> root.sep-set;
                        show2: true; show3: false;
                        edited1(s) => { root.sep-edited("List", s); }
                        edited2(s) => { root.sep-edited("Set", s); }
                    }

                    // Map
                    Text { text: "Map"; color: Theme.text-secondary; font-size: Theme.fs-small; }
                    SepRow {
                        l1: "Map.kv"; v1 <=> root.sep-map-kv;
                        l2: "Map.entry"; v2 <=> root.sep-map-entry;
                        show2: true; show3: false;
                        edited1(s) => { root.sep-edited("Map.kv", s); }
                        edited2(s) => { root.sep-edited("Map.entry", s); }
                    }

                    // List<TupleN>
                    Text { text: "List<TupleN>"; color: Theme.text-secondary; font-size: Theme.fs-small; }
                    SepRow {
                        l1: "List_Tuple2.tuple"; v1 <=> root.sep-lt2-tuple;
                        l2: "List_Tuple2.list"; v2 <=> root.sep-lt2-list;
                        show2: true; show3: false;
                        edited1(s) => { root.sep-edited("List_Tuple2.tuple", s); }
                        edited2(s) => { root.sep-edited("List_Tuple2.list", s); }
                    }
                    SepRow {
                        l1: "List_Tuple3.tuple"; v1 <=> root.sep-lt3-tuple;
                        l2: "List_Tuple3.list"; v2 <=> root.sep-lt3-list;
                        show2: true; show3: false;
                        edited1(s) => { root.sep-edited("List_Tuple3.tuple", s); }
                        edited2(s) => { root.sep-edited("List_Tuple3.list", s); }
                    }
                    SepRow {
                        l1: "List_Tuple4.tuple"; v1 <=> root.sep-lt4-tuple;
                        l2: "List_Tuple4.list"; v2 <=> root.sep-lt4-list;
                        show2: true; show3: false;
                        edited1(s) => { root.sep-edited("List_Tuple4.tuple", s); }
                        edited2(s) => { root.sep-edited("List_Tuple4.list", s); }
                    }

                    // Map<*,TupleN>
                    Text { text: "Map<*,TupleN>"; color: Theme.text-secondary; font-size: Theme.fs-small; }
                    SepRow {
                        l1: "Map_Tuple2.kv"; v1 <=> root.sep-mt2-kv;
                        l2: "Map_Tuple2.tuple"; v2 <=> root.sep-mt2-tuple;
                        l3: "Map_Tuple2.entry"; v3 <=> root.sep-mt2-entry;
                        show2: true; show3: true;
                        edited1(s) => { root.sep-edited("Map_Tuple2.kv", s); }
                        edited2(s) => { root.sep-edited("Map_Tuple2.tuple", s); }
                        edited3(s) => { root.sep-edited("Map_Tuple2.entry", s); }
                    }
                    SepRow {
                        l1: "Map_Tuple3.kv"; v1 <=> root.sep-mt3-kv;
                        l2: "Map_Tuple3.tuple"; v2 <=> root.sep-mt3-tuple;
                        l3: "Map_Tuple3.entry"; v3 <=> root.sep-mt3-entry;
                        show2: true; show3: true;
                        edited1(s) => { root.sep-edited("Map_Tuple3.kv", s); }
                        edited2(s) => { root.sep-edited("Map_Tuple3.tuple", s); }
                        edited3(s) => { root.sep-edited("Map_Tuple3.entry", s); }
                    }
                    SepRow {
                        l1: "Map_Tuple4.kv"; v1 <=> root.sep-mt4-kv;
                        l2: "Map_Tuple4.tuple"; v2 <=> root.sep-mt4-tuple;
                        l3: "Map_Tuple4.entry"; v3 <=> root.sep-mt4-entry;
                        show2: true; show3: true;
                        edited1(s) => { root.sep-edited("Map_Tuple4.kv", s); }
                        edited2(s) => { root.sep-edited("Map_Tuple4.tuple", s); }
                        edited3(s) => { root.sep-edited("Map_Tuple4.entry", s); }
                    }

                    // Map<*,List>
                    Text { text: "Map<*,List>"; color: Theme.text-secondary; font-size: Theme.fs-small; }
                    SepRow {
                        l1: "Map_List.kv"; v1 <=> root.sep-ml-kv;
                        l2: "Map_List.item"; v2 <=> root.sep-ml-item;
                        l3: "Map_List.entry"; v3 <=> root.sep-ml-entry;
                        show2: true; show3: true;
                        edited1(s) => { root.sep-edited("Map_List.kv", s); }
                        edited2(s) => { root.sep-edited("Map_List.item", s); }
                        edited3(s) => { root.sep-edited("Map_List.entry", s); }
                    }
                }
            }

            // 导出设置 tab
            if root.tab == 2: ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    padding: Theme.sp-4;
                    spacing: Theme.sp-4;

                    // 通用设置
                    Text { text: "通用设置"; color: Theme.text-secondary; font-size: Theme.fs-small; font-weight: 600; }
                    HorizontalLayout {
                        spacing: Theme.sp-3;
                        alignment: start;
                        Text { text: "编码:"; width: 140px; vertical-alignment: center; color: Theme.text-primary; }
                        ComboBox {
                            model: root.ps-encoding-options;
                            current-index <=> root.ps-export-encoding-index;
                            width: 180px;
                            selected(s) => { root.export-field-edited("encoding", s); }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.sp-3;
                        alignment: start;
                        Text { text: "换行符:"; width: 140px; vertical-alignment: center; color: Theme.text-primary; }
                        ComboBox {
                            model: root.ps-line-ending-options;
                            current-index <=> root.ps-export-line-ending-index;
                            width: 180px;
                            selected(s) => { root.export-field-edited("line_ending", s); }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.border; }

                    // JSON/XML 配置
                    Text { text: "数据格式"; color: Theme.text-secondary; font-size: Theme.fs-small; font-weight: 600; }
                    HorizontalLayout {
                        spacing: Theme.sp-3;
                        alignment: start;
                        Text { text: "JSON 空值处理:"; width: 140px; vertical-alignment: center; color: Theme.text-primary; }
                        ComboBox {
                            model: root.ps-json-empty-as-options;
                            current-index <=> root.ps-export-json-empty-as-index;
                            width: 180px;
                            selected(s) => { root.export-field-edited("json_empty_as", s); }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.sp-3;
                        alignment: start;
                        Text { text: "XML 空值处理:"; width: 140px; vertical-alignment: center; color: Theme.text-primary; }
                        ComboBox {
                            model: root.ps-xml-empty-as-options;
                            current-index <=> root.ps-export-xml-empty-as-index;
                            width: 180px;
                            selected(s) => { root.export-field-edited("xml_empty_as", s); }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.border; }

                    // 服务端配置
                    Text { text: "服务端"; color: Theme.text-secondary; font-size: Theme.fs-small; font-weight: 600; }
                    HorizontalLayout {
                        spacing: Theme.sp-3;
                        alignment: start;
                        Text { text: "数据输出目录:"; width: 140px; vertical-alignment: center; color: Theme.text-primary; }
                        LineEdit {
                            text <=> root.ps-export-server-data-output;
                            width: 300px;
                            edited(s) => { root.export-field-edited("server_data_output", s); }
                        }
                    }

                    Text { text: "Java"; color: Theme.text-secondary; font-size: Theme.fs-tiny; }
                    HorizontalLayout {
                        spacing: Theme.sp-3;
                        alignment: start;
                        Text { text: "  package:"; width: 140px; vertical-alignment: center; color: Theme.text-primary; }
                        LineEdit {
                            text <=> root.ps-export-java-package;
                            width: 300px;
                            edited(s) => { root.export-field-edited("java_package", s); }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.sp-3;
                        alignment: start;
                        Text { text: "  code_output:"; width: 140px; vertical-alignment: center; color: Theme.text-primary; }
                        LineEdit {
                            text <=> root.ps-export-java-code-output;
                            width: 300px;
                            edited(s) => { root.export-field-edited("java_code_output", s); }
                        }
                    }

                    Text { text: "Go"; color: Theme.text-secondary; font-size: Theme.fs-tiny; }
                    HorizontalLayout {
                        spacing: Theme.sp-3;
                        alignment: start;
                        Text { text: "  package:"; width: 140px; vertical-alignment: center; color: Theme.text-primary; }
                        LineEdit {
                            text <=> root.ps-export-go-package;
                            width: 300px;
                            edited(s) => { root.export-field-edited("go_package", s); }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.sp-3;
                        alignment: start;
                        Text { text: "  code_output:"; width: 140px; vertical-alignment: center; color: Theme.text-primary; }
                        LineEdit {
                            text <=> root.ps-export-go-code-output;
                            width: 300px;
                            edited(s) => { root.export-field-edited("go_code_output", s); }
                        }
                    }

                    Text { text: "C++"; color: Theme.text-secondary; font-size: Theme.fs-tiny; }
                    HorizontalLayout {
                        spacing: Theme.sp-3;
                        alignment: start;
                        Text { text: "  namespace:"; width: 140px; vertical-alignment: center; color: Theme.text-primary; }
                        LineEdit {
                            text <=> root.ps-export-cpp-namespace;
                            width: 300px;
                            edited(s) => { root.export-field-edited("cpp_namespace", s); }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.sp-3;
                        alignment: start;
                        Text { text: "  code_output:"; width: 140px; vertical-alignment: center; color: Theme.text-primary; }
                        LineEdit {
                            text <=> root.ps-export-cpp-code-output;
                            width: 300px;
                            edited(s) => { root.export-field-edited("cpp_code_output", s); }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.sp-3;
                        alignment: start;
                        Text { text: "  json_lib:"; width: 140px; vertical-alignment: center; color: Theme.text-primary; }
                        ComboBox {
                            model: root.ps-cpp-json-lib-options;
                            current-index <=> root.ps-export-cpp-json-lib-index;
                            width: 180px;
                            selected(s) => { root.export-field-edited("cpp_json_lib", s); }
                        }
                    }

                    Text { text: "C# (.NET)"; color: Theme.text-secondary; font-size: Theme.fs-tiny; }
                    HorizontalLayout {
                        spacing: Theme.sp-3;
                        alignment: start;
                        Text { text: "  namespace:"; width: 140px; vertical-alignment: center; color: Theme.text-primary; }
                        LineEdit {
                            text <=> root.ps-export-csharp-dotnet-namespace;
                            width: 300px;
                            edited(s) => { root.export-field-edited("csharp_dotnet_namespace", s); }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.sp-3;
                        alignment: start;
                        Text { text: "  code_output:"; width: 140px; vertical-alignment: center; color: Theme.text-primary; }
                        LineEdit {
                            text <=> root.ps-export-csharp-dotnet-code-output;
                            width: 300px;
                            edited(s) => { root.export-field-edited("csharp_dotnet_code_output", s); }
                        }
                    }

                    Text { text: "TypeScript"; color: Theme.text-secondary; font-size: Theme.fs-tiny; }
                    HorizontalLayout {
                        spacing: Theme.sp-3;
                        alignment: start;
                        Text { text: "  code_output:"; width: 140px; vertical-alignment: center; color: Theme.text-primary; }
                        LineEdit {
                            text <=> root.ps-export-typescript-server-code-output;
                            width: 300px;
                            edited(s) => { root.export-field-edited("typescript_server_code_output", s); }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.border; }

                    // 客户端配置
                    Text { text: "客户端"; color: Theme.text-secondary; font-size: Theme.fs-small; font-weight: 600; }

                    Text { text: "Lua"; color: Theme.text-secondary; font-size: Theme.fs-tiny; }
                    HorizontalLayout {
                        spacing: Theme.sp-3;
                        alignment: start;
                        Text { text: "  output:"; width: 140px; vertical-alignment: center; color: Theme.text-primary; }
                        LineEdit {
                            text <=> root.ps-export-lua-output;
                            width: 300px;
                            edited(s) => { root.export-field-edited("lua_output", s); }
                        }
                    }

                    Text { text: "GDScript"; color: Theme.text-secondary; font-size: Theme.fs-tiny; }
                    HorizontalLayout {
                        spacing: Theme.sp-3;
                        alignment: start;
                        Text { text: "  output:"; width: 140px; vertical-alignment: center; color: Theme.text-primary; }
                        LineEdit {
                            text <=> root.ps-export-gdscript-output;
                            width: 300px;
                            edited(s) => { root.export-field-edited("gdscript_output", s); }
                        }
                    }

                    Text { text: "TypeScript"; color: Theme.text-secondary; font-size: Theme.fs-tiny; }
                    HorizontalLayout {
                        spacing: Theme.sp-3;
                        alignment: start;
                        Text { text: "  output:"; width: 140px; vertical-alignment: center; color: Theme.text-primary; }
                        LineEdit {
                            text <=> root.ps-export-typescript-client-output;
                            width: 300px;
                            edited(s) => { root.export-field-edited("typescript_client_output", s); }
                        }
                    }

                    Text { text: "C# (Unity)"; color: Theme.text-secondary; font-size: Theme.fs-tiny; }
                    HorizontalLayout {
                        spacing: Theme.sp-3;
                        alignment: start;
                        Text { text: "  namespace:"; width: 140px; vertical-alignment: center; color: Theme.text-primary; }
                        LineEdit {
                            text <=> root.ps-export-csharp-unity-namespace;
                            width: 300px;
                            edited(s) => { root.export-field-edited("csharp_unity_namespace", s); }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.sp-3;
                        alignment: start;
                        Text { text: "  code_output:"; width: 140px; vertical-alignment: center; color: Theme.text-primary; }
                        LineEdit {
                            text <=> root.ps-export-csharp-unity-code-output;
                            width: 300px;
                            edited(s) => { root.export-field-edited("csharp_unity_code_output", s); }
                        }
                    }

                    Text { text: "C# (Godot)"; color: Theme.text-secondary; font-size: Theme.fs-tiny; }
                    HorizontalLayout {
                        spacing: Theme.sp-3;
                        alignment: start;
                        Text { text: "  namespace:"; width: 140px; vertical-alignment: center; color: Theme.text-primary; }
                        LineEdit {
                            text <=> root.ps-export-csharp-godot-namespace;
                            width: 300px;
                            edited(s) => { root.export-field-edited("csharp_godot_namespace", s); }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.sp-3;
                        alignment: start;
                        Text { text: "  code_output:"; width: 140px; vertical-alignment: center; color: Theme.text-primary; }
                        LineEdit {
                            text <=> root.ps-export-csharp-godot-code-output;
                            width: 300px;
                            edited(s) => { root.export-field-edited("csharp_godot_code_output", s); }
                        }
                    }

                    Text {
                        text: "提示：导出配置点确定后更新内存，需保存项目才写盘。";
                        color: Theme.text-secondary;
                        font-size: Theme.fs-tiny;
                        wrap: word-wrap;
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }
        }
    }
}
