// 项目设置对话框：身份（id/name/category/version）+ 分隔符（25 leaves）2 tab。

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { ModifiedField } from "../components/modified_field.slint";
import { DialogChrome } from "dialog_chrome.slint";
import { LineEdit, ScrollView, ComboBox, CheckBox } from "std-widgets.slint";

// Tab segmented bar：身份 / 分隔符 / 导出设置
component TabBar inherits Rectangle {
    in property <int> current: 0;
    callback changed(int);

    height: 32px;
    background: Theme.bg-toolbar;
    border-color: Theme.border-light;
    border-width: 1px;

    HorizontalLayout {
        spacing: 0;
        padding-left: Theme.sp-3;
        padding-top: 4px;
        alignment: start;
        Rectangle {
            width: 96px;
            background: root.current == 0 ? Theme.bg-row-selected : transparent;
            Text {
                text: "身份";
                font-size: Theme.fs-normal;
                color: Theme.text-primary;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            TouchArea { clicked => { root.changed(0); } }
        }
        Rectangle {
            width: 96px;
            background: root.current == 1 ? Theme.bg-row-selected : transparent;
            Text {
                text: "分隔符";
                font-size: Theme.fs-normal;
                color: Theme.text-primary;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            TouchArea { clicked => { root.changed(1); } }
        }
        Rectangle {
            width: 96px;
            background: root.current == 2 ? Theme.bg-row-selected : transparent;
            Text {
                text: "导出设置";
                font-size: Theme.fs-normal;
                color: Theme.text-primary;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            TouchArea { clicked => { root.changed(2); } }
        }
    }
}

// 单条紧凑分隔符行：[label][input][label][input]...（label 70px，input 64px）
component SepRow inherits HorizontalLayout {
    in property <string> l1;
    in-out property <string> v1;
    in property <bool> m1: false;
    in property <string> l2;
    in-out property <string> v2;
    in property <bool> m2: false;
    in property <string> l3;
    in-out property <string> v3;
    in property <bool> m3: false;
    in property <bool> show2: true;
    in property <bool> show3: false;
    callback edited1(string);
    callback edited2(string);
    callback edited3(string);
    callback revert1();
    callback revert2();
    callback revert3();

    spacing: Theme.sp-2;
    alignment: start;

    Text {
        text: root.l1; width: 96px;
        color: Theme.text-primary;
        vertical-alignment: center;
        horizontal-alignment: end;
    }
    ModifiedField {
        // 宽度常驻（不亮时只藏 opacity），否则每敲一个字整行左右跳
        modified: root.m1;
        revert => { root.revert1(); }
        LineEdit {
            text <=> root.v1;
            width: 56px;
            edited(s) => { root.edited1(s); }
        }
    }
    if root.show2: Text {
        text: root.l2; width: 96px;
        color: Theme.text-primary;
        vertical-alignment: center;
        horizontal-alignment: end;
    }
    if root.show2: ModifiedField {
        modified: root.m2;
        revert => { root.revert2(); }
        LineEdit {
            text <=> root.v2;
            width: 56px;
            edited(s) => { root.edited2(s); }
        }
    }
    if root.show3: Text {
        text: root.l3; width: 96px;
        color: Theme.text-primary;
        vertical-alignment: center;
        horizontal-alignment: end;
    }
    if root.show3: ModifiedField {
        modified: root.m3;
        revert => { root.revert3(); }
        LineEdit {
            text <=> root.v3;
            width: 56px;
            edited(s) => { root.edited3(s); }
        }
    }
}

export component ProjectSettingsDialog inherits Rectangle {
    in property <bool> open: false;
    in property <int> tab: 0;
    // 属性名与 AppWindow 上的 `ps-*` **完全一致** —— app.slint 那边是一比一机械绑定，
    // 一眼能看出有没有漏绑。新增字段两边各加一行，名字必须一致。
    //
    // `*-modified` = 「这个字段和盘上不一样吗」，由后端按 `Project::original_*` 算好推上来
    // （@02.26.2）。这里不做比较：`None` 与 `Some(默认值)` 的差别在渲染值上看不出来。
    in property <string> ps-id;
    in property <bool> ps-can-revert-all: false;
    in-out property <string> ps-name;
    in property <bool> ps-name-modified: false;
    in-out property <string> ps-category;
    in property <bool> ps-category-modified: false;
    in-out property <string> ps-version;
    in property <bool> ps-version-modified: false;

    in-out property <string> ps-sep-tuple2;
    in property <bool> ps-sep-tuple2-modified: false;
    in-out property <string> ps-sep-tuple3;
    in property <bool> ps-sep-tuple3-modified: false;
    in-out property <string> ps-sep-tuple4;
    in property <bool> ps-sep-tuple4-modified: false;
    in-out property <string> ps-sep-list;
    in property <bool> ps-sep-list-modified: false;
    in-out property <string> ps-sep-set;
    in property <bool> ps-sep-set-modified: false;
    in-out property <string> ps-sep-map-kv;
    in property <bool> ps-sep-map-kv-modified: false;
    in-out property <string> ps-sep-map-entry;
    in property <bool> ps-sep-map-entry-modified: false;
    in-out property <string> ps-sep-lt2-tuple;
    in property <bool> ps-sep-lt2-tuple-modified: false;
    in-out property <string> ps-sep-lt2-list;
    in property <bool> ps-sep-lt2-list-modified: false;
    in-out property <string> ps-sep-lt3-tuple;
    in property <bool> ps-sep-lt3-tuple-modified: false;
    in-out property <string> ps-sep-lt3-list;
    in property <bool> ps-sep-lt3-list-modified: false;
    in-out property <string> ps-sep-lt4-tuple;
    in property <bool> ps-sep-lt4-tuple-modified: false;
    in-out property <string> ps-sep-lt4-list;
    in property <bool> ps-sep-lt4-list-modified: false;
    in-out property <string> ps-sep-mt2-kv;
    in property <bool> ps-sep-mt2-kv-modified: false;
    in-out property <string> ps-sep-mt2-tuple;
    in property <bool> ps-sep-mt2-tuple-modified: false;
    in-out property <string> ps-sep-mt2-entry;
    in property <bool> ps-sep-mt2-entry-modified: false;
    in-out property <string> ps-sep-mt3-kv;
    in property <bool> ps-sep-mt3-kv-modified: false;
    in-out property <string> ps-sep-mt3-tuple;
    in property <bool> ps-sep-mt3-tuple-modified: false;
    in-out property <string> ps-sep-mt3-entry;
    in property <bool> ps-sep-mt3-entry-modified: false;
    in-out property <string> ps-sep-mt4-kv;
    in property <bool> ps-sep-mt4-kv-modified: false;
    in-out property <string> ps-sep-mt4-tuple;
    in property <bool> ps-sep-mt4-tuple-modified: false;
    in-out property <string> ps-sep-mt4-entry;
    in property <bool> ps-sep-mt4-entry-modified: false;
    in-out property <string> ps-sep-ml-kv;
    in property <bool> ps-sep-ml-kv-modified: false;
    in-out property <string> ps-sep-ml-item;
    in property <bool> ps-sep-ml-item-modified: false;
    in-out property <string> ps-sep-ml-entry;
    in property <bool> ps-sep-ml-entry-modified: false;

    in property <[string]> ps-encoding-options;
    in property <[string]> ps-line-ending-options;
    in property <[string]> ps-json-empty-as-options;
    in property <[string]> ps-xml-empty-as-options;
    in property <[string]> ps-cpp-json-lib-options;
    in-out property <int> ps-export-encoding-index;
    in property <bool> ps-export-encoding-modified: false;
    in-out property <int> ps-export-line-ending-index;
    in property <bool> ps-export-line-ending-modified: false;
    in-out property <int> ps-export-json-empty-as-index;
    in property <bool> ps-export-json-empty-as-modified: false;
    in-out property <int> ps-export-xml-empty-as-index;
    in property <bool> ps-export-xml-empty-as-modified: false;
    in-out property <int> ps-export-cpp-json-lib-index;
    in property <bool> ps-export-cpp-json-lib-modified: false;
    in-out property <string> ps-export-server-data-output;
    in property <bool> ps-export-server-data-output-modified: false;
    in-out property <string> ps-export-java-package;
    in property <bool> ps-export-java-package-modified: false;
    in-out property <string> ps-export-java-code-output;
    in property <bool> ps-export-java-code-output-modified: false;
    in-out property <string> ps-export-go-package;
    in property <bool> ps-export-go-package-modified: false;
    in-out property <string> ps-export-go-code-output;
    in property <bool> ps-export-go-code-output-modified: false;
    in-out property <string> ps-export-cpp-namespace;
    in property <bool> ps-export-cpp-namespace-modified: false;
    in-out property <string> ps-export-cpp-code-output;
    in property <bool> ps-export-cpp-code-output-modified: false;
    in-out property <string> ps-export-csharp-dotnet-namespace;
    in property <bool> ps-export-csharp-dotnet-namespace-modified: false;
    in-out property <string> ps-export-csharp-dotnet-code-output;
    in property <bool> ps-export-csharp-dotnet-code-output-modified: false;
    in-out property <string> ps-export-typescript-server-code-output;
    in property <bool> ps-export-typescript-server-code-output-modified: false;
    in-out property <string> ps-export-lua-output;
    in property <bool> ps-export-lua-output-modified: false;
    in-out property <string> ps-export-gdscript-output;
    in property <bool> ps-export-gdscript-output-modified: false;
    in-out property <string> ps-export-typescript-client-output;
    in property <bool> ps-export-typescript-client-output-modified: false;
    in-out property <string> ps-export-csharp-unity-namespace;
    in property <bool> ps-export-csharp-unity-namespace-modified: false;
    in-out property <string> ps-export-csharp-unity-code-output;
    in property <bool> ps-export-csharp-unity-code-output-modified: false;
    in-out property <string> ps-export-csharp-godot-namespace;
    in property <bool> ps-export-csharp-godot-namespace-modified: false;
    in-out property <string> ps-export-csharp-godot-code-output;
    in property <bool> ps-export-csharp-godot-code-output-modified: false;
    in-out property <bool> ps-export-cpp-custom-regions;
    in property <bool> ps-export-cpp-custom-regions-modified: false;
    in-out property <bool> ps-export-java-lombok;
    in property <bool> ps-export-java-lombok-modified: false;
    in-out property <bool> ps-export-java-custom-regions;
    in property <bool> ps-export-java-custom-regions-modified: false;
    in-out property <bool> ps-export-go-custom-regions;
    in property <bool> ps-export-go-custom-regions-modified: false;
    in-out property <bool> ps-export-csharp-dotnet-custom-regions;
    in property <bool> ps-export-csharp-dotnet-custom-regions-modified: false;
    in-out property <bool> ps-export-csharp-unity-custom-regions;
    in property <bool> ps-export-csharp-unity-custom-regions-modified: false;
    in-out property <bool> ps-export-csharp-godot-custom-regions;
    in property <bool> ps-export-csharp-godot-custom-regions-modified: false;

    callback tab-changed(int);
    callback name-edited(string);
    callback category-edited(string);
    callback version-edited(string);
    /// (key, value) —— key 与 `SepKey::as_directive_key()` 一致
    callback sep-edited(string, string);
    /// (key, value) —— key 与 `ExportKey::as_str()` 一致
    callback export-field-edited(string, string);
    /// 单字段还原：把 original_* 的对应叶子写回（@02.26）
    callback identity-revert(string);
    callback sep-revert(string);
    callback export-revert(string);
    callback reset-sep();
    callback reset-export();
    callback revert-all();
    /// 确定 = 关闭
    callback confirm();

    visible: root.open;
    width: 100%;
    height: 100%;

    DialogChrome {
        title: "项目设置";
        dialog-w: 720px;
        dialog-h: 560px;
        primary-text: "确定";
        primary-clicked => { root.confirm(); }
        // **没有取消**：编辑实时落内存，关闭即保留（@02.26）。反悔靠字段上的还原按钮
        // 与「全部还原」，不是靠关掉重来。遮罩点击也走 confirm —— 已经没有「取消」可以等同了。
        show-cancel: false;
        cancel-clicked => { root.confirm(); }
        scrim-clicked => { root.confirm(); }
        show-secondary: root.tab == 1 || root.tab == 2;
        secondary-text: "应用模板";
        secondary-clicked => {
            if root.tab == 1 {
                root.reset-sep();
            } else if root.tab == 2 {
                root.reset-export();
            }
        }
        show-third: true;
        third-text: "全部还原";
        third-enabled: root.ps-can-revert-all;
        third-clicked => { root.revert-all(); }

        VerticalLayout {
            spacing: 0;
            padding: 0;

            TabBar {
                current: root.tab;
                changed(i) => { root.tab-changed(i); }
            }

            // 身份 tab —— id 只读，其余三行可编辑
            if root.tab == 0: Rectangle {
                vertical-stretch: 1;
                VerticalLayout {
                    padding: Theme.sp-4;
                    spacing: Theme.sp-3;

                    // id 只读：它在新建 / 克隆对话框里定，之后改 id 要搬目录、风险大（@02.26）。
                    // 所以这里是「锁 + 文字」，不是输入框。
                    HorizontalLayout {
                        spacing: Theme.sp-3;
                        alignment: stretch;
                        Text { text: "项目 ID:"; width: 96px; vertical-alignment: center; color: Theme.text-primary; }
                        Text {
                            text: Icons.lock + " " + root.ps-id;
                            vertical-alignment: center;
                            color: Theme.text-secondary;
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.sp-3;
                        alignment: stretch;
                        Text { text: "名称:"; width: 96px; vertical-alignment: center; color: Theme.text-primary; }
                        ModifiedField {
                            horizontal-stretch: 1;
                            modified: root.ps-name-modified;
                            revert => { root.identity-revert("name"); }
                            LineEdit {
                            text <=> root.ps-name;
                            horizontal-stretch: 1;
                            edited(s) => { root.name-edited(s); }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.sp-3;
                        alignment: stretch;
                        Text { text: "分类:"; width: 96px; vertical-alignment: center; color: Theme.text-primary; }
                        ModifiedField {
                            horizontal-stretch: 1;
                            modified: root.ps-category-modified;
                            revert => { root.identity-revert("category"); }
                            LineEdit {
                            text <=> root.ps-category;
                            horizontal-stretch: 1;
                            edited(s) => { root.category-edited(s); }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.sp-3;
                        alignment: stretch;
                        Text { text: "版本:"; width: 96px; vertical-alignment: center; color: Theme.text-primary; }
                        ModifiedField {
                            horizontal-stretch: 1;
                            modified: root.ps-version-modified;
                            revert => { root.identity-revert("version"); }
                            LineEdit {
                            text <=> root.ps-version;
                            horizontal-stretch: 1;
                            edited(s) => { root.version-edited(s); }
                            }
                        }
                    }
                    Text {
                        text: "提示：id 可改（项目尚未保存）；保存后 id 将固定，其它字段随项目保存落到 .tblschema。";
                        color: Theme.text-secondary;
                        font-size: Theme.fs-tiny;
                        wrap: word-wrap;
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }

            // 分隔符 tab —— 紧凑分组
            if root.tab == 1: ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    padding: Theme.sp-4;
                    spacing: Theme.sp-3;

                    // 基础容器
                    Text { text: "基础"; color: Theme.text-secondary; font-size: Theme.fs-small; }
                    SepRow {
                        l1: "Tuple2"; v1 <=> root.ps-sep-tuple2;
                        l2: "Tuple3"; v2 <=> root.ps-sep-tuple3;
                        l3: "Tuple4"; v3 <=> root.ps-sep-tuple4;
                        show2: true; show3: true;
                        m1: root.ps-sep-tuple2-modified;
                        revert1 => { root.sep-revert("Tuple2"); }
                        m2: root.ps-sep-tuple3-modified;
                        revert2 => { root.sep-revert("Tuple3"); }
                        m3: root.ps-sep-tuple4-modified;
                        revert3 => { root.sep-revert("Tuple4"); }
                        edited1(s) => { root.sep-edited("Tuple2", s); }
                        edited2(s) => { root.sep-edited("Tuple3", s); }
                        edited3(s) => { root.sep-edited("Tuple4", s); }
                    }
                    SepRow {
                        l1: "List"; v1 <=> root.ps-sep-list;
                        l2: "Set"; v2 <=> root.ps-sep-set;
                        show2: true; show3: false;
                        m1: root.ps-sep-list-modified;
                        revert1 => { root.sep-revert("List"); }
                        m2: root.ps-sep-set-modified;
                        revert2 => { root.sep-revert("Set"); }
                        edited1(s) => { root.sep-edited("List", s); }
                        edited2(s) => { root.sep-edited("Set", s); }
                    }

                    // Map
                    Text { text: "Map"; color: Theme.text-secondary; font-size: Theme.fs-small; }
                    SepRow {
                        l1: "Map.kv"; v1 <=> root.ps-sep-map-kv;
                        l2: "Map.entry"; v2 <=> root.ps-sep-map-entry;
                        show2: true; show3: false;
                        m1: root.ps-sep-map-kv-modified;
                        revert1 => { root.sep-revert("Map.kv"); }
                        m2: root.ps-sep-map-entry-modified;
                        revert2 => { root.sep-revert("Map.entry"); }
                        edited1(s) => { root.sep-edited("Map.kv", s); }
                        edited2(s) => { root.sep-edited("Map.entry", s); }
                    }

                    // List<TupleN>
                    Text { text: "List<TupleN>"; color: Theme.text-secondary; font-size: Theme.fs-small; }
                    SepRow {
                        l1: "List_Tuple2.tuple"; v1 <=> root.ps-sep-lt2-tuple;
                        l2: "List_Tuple2.list"; v2 <=> root.ps-sep-lt2-list;
                        show2: true; show3: false;
                        m1: root.ps-sep-lt2-tuple-modified;
                        revert1 => { root.sep-revert("List_Tuple2.tuple"); }
                        m2: root.ps-sep-lt2-list-modified;
                        revert2 => { root.sep-revert("List_Tuple2.list"); }
                        edited1(s) => { root.sep-edited("List_Tuple2.tuple", s); }
                        edited2(s) => { root.sep-edited("List_Tuple2.list", s); }
                    }
                    SepRow {
                        l1: "List_Tuple3.tuple"; v1 <=> root.ps-sep-lt3-tuple;
                        l2: "List_Tuple3.list"; v2 <=> root.ps-sep-lt3-list;
                        show2: true; show3: false;
                        m1: root.ps-sep-lt3-tuple-modified;
                        revert1 => { root.sep-revert("List_Tuple3.tuple"); }
                        m2: root.ps-sep-lt3-list-modified;
                        revert2 => { root.sep-revert("List_Tuple3.list"); }
                        edited1(s) => { root.sep-edited("List_Tuple3.tuple", s); }
                        edited2(s) => { root.sep-edited("List_Tuple3.list", s); }
                    }
                    SepRow {
                        l1: "List_Tuple4.tuple"; v1 <=> root.ps-sep-lt4-tuple;
                        l2: "List_Tuple4.list"; v2 <=> root.ps-sep-lt4-list;
                        show2: true; show3: false;
                        m1: root.ps-sep-lt4-tuple-modified;
                        revert1 => { root.sep-revert("List_Tuple4.tuple"); }
                        m2: root.ps-sep-lt4-list-modified;
                        revert2 => { root.sep-revert("List_Tuple4.list"); }
                        edited1(s) => { root.sep-edited("List_Tuple4.tuple", s); }
                        edited2(s) => { root.sep-edited("List_Tuple4.list", s); }
                    }

                    // Map<*,TupleN>
                    Text { text: "Map<*,TupleN>"; color: Theme.text-secondary; font-size: Theme.fs-small; }
                    SepRow {
                        l1: "Map_Tuple2.kv"; v1 <=> root.ps-sep-mt2-kv;
                        l2: "Map_Tuple2.tuple"; v2 <=> root.ps-sep-mt2-tuple;
                        l3: "Map_Tuple2.entry"; v3 <=> root.ps-sep-mt2-entry;
                        show2: true; show3: true;
                        m1: root.ps-sep-mt2-kv-modified;
                        revert1 => { root.sep-revert("Map_Tuple2.kv"); }
                        m2: root.ps-sep-mt2-tuple-modified;
                        revert2 => { root.sep-revert("Map_Tuple2.tuple"); }
                        m3: root.ps-sep-mt2-entry-modified;
                        revert3 => { root.sep-revert("Map_Tuple2.entry"); }
                        edited1(s) => { root.sep-edited("Map_Tuple2.kv", s); }
                        edited2(s) => { root.sep-edited("Map_Tuple2.tuple", s); }
                        edited3(s) => { root.sep-edited("Map_Tuple2.entry", s); }
                    }
                    SepRow {
                        l1: "Map_Tuple3.kv"; v1 <=> root.ps-sep-mt3-kv;
                        l2: "Map_Tuple3.tuple"; v2 <=> root.ps-sep-mt3-tuple;
                        l3: "Map_Tuple3.entry"; v3 <=> root.ps-sep-mt3-entry;
                        show2: true; show3: true;
                        m1: root.ps-sep-mt3-kv-modified;
                        revert1 => { root.sep-revert("Map_Tuple3.kv"); }
                        m2: root.ps-sep-mt3-tuple-modified;
                        revert2 => { root.sep-revert("Map_Tuple3.tuple"); }
                        m3: root.ps-sep-mt3-entry-modified;
                        revert3 => { root.sep-revert("Map_Tuple3.entry"); }
                        edited1(s) => { root.sep-edited("Map_Tuple3.kv", s); }
                        edited2(s) => { root.sep-edited("Map_Tuple3.tuple", s); }
                        edited3(s) => { root.sep-edited("Map_Tuple3.entry", s); }
                    }
                    SepRow {
                        l1: "Map_Tuple4.kv"; v1 <=> root.ps-sep-mt4-kv;
                        l2: "Map_Tuple4.tuple"; v2 <=> root.ps-sep-mt4-tuple;
                        l3: "Map_Tuple4.entry"; v3 <=> root.ps-sep-mt4-entry;
                        show2: true; show3: true;
                        m1: root.ps-sep-mt4-kv-modified;
                        revert1 => { root.sep-revert("Map_Tuple4.kv"); }
                        m2: root.ps-sep-mt4-tuple-modified;
                        revert2 => { root.sep-revert("Map_Tuple4.tuple"); }
                        m3: root.ps-sep-mt4-entry-modified;
                        revert3 => { root.sep-revert("Map_Tuple4.entry"); }
                        edited1(s) => { root.sep-edited("Map_Tuple4.kv", s); }
                        edited2(s) => { root.sep-edited("Map_Tuple4.tuple", s); }
                        edited3(s) => { root.sep-edited("Map_Tuple4.entry", s); }
                    }

                    // Map<*,List>
                    Text { text: "Map<*,List>"; color: Theme.text-secondary; font-size: Theme.fs-small; }
                    SepRow {
                        l1: "Map_List.kv"; v1 <=> root.ps-sep-ml-kv;
                        l2: "Map_List.item"; v2 <=> root.ps-sep-ml-item;
                        l3: "Map_List.entry"; v3 <=> root.ps-sep-ml-entry;
                        show2: true; show3: true;
                        m1: root.ps-sep-ml-kv-modified;
                        revert1 => { root.sep-revert("Map_List.kv"); }
                        m2: root.ps-sep-ml-item-modified;
                        revert2 => { root.sep-revert("Map_List.item"); }
                        m3: root.ps-sep-ml-entry-modified;
                        revert3 => { root.sep-revert("Map_List.entry"); }
                        edited1(s) => { root.sep-edited("Map_List.kv", s); }
                        edited2(s) => { root.sep-edited("Map_List.item", s); }
                        edited3(s) => { root.sep-edited("Map_List.entry", s); }
                    }
                }
