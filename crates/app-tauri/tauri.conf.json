{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tablet-tauri",
  "identifier": "com.juebanlin.tablet.tauri",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "tablet",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/128x128.png"]
  }
}
