#!tblschema v1
# @meta id: sanguo
# @meta name: 三国志游戏配置模板
# @meta category: sample
# @meta version: 1.0.0
# @meta has_preset: true

# 三国题材城池经营策略游戏配置模板。来源：《三国志游戏 - 系统策划文档 v2.1》。
# 涵盖：势力 / 武将品质 / 建筑类别 / 兵种 / 科技 / 地形 / 资源 等枚举；
#       全局常量（地图、城池上限、初始资源、关键武将引用）；
#       武将 / 建筑 / 兵种 / 科技 / 资源点 / 区域 / 城防 / 装备 等数据表。

# ──────────────── Enum 段 ────────────────

[enums/Faction] enum
# @preset
1 | WEI     | 魏
2 | SHU     | 蜀
3 | WU      | 吴
4 | HAN     | 汉
5 | NEUTRAL | 中立

[enums/HeroQuality] enum
# @preset
1 | COMMON    | 普通
2 | UNCOMMON  | 优秀
3 | RARE      | 稀有
4 | EPIC      | 史诗
5 | LEGENDARY | 传说

[enums/HeroAttr] enum
# @preset
1 | LEADERSHIP | 统率
2 | ATTACK     | 攻击
3 | HEALTH     | 体力
4 | SPEED      | 速度
5 | DEFENSE    | 防御
6 | INTELLECT  | 智力
7 | CHARM      | 魅力
8 | POLITICS   | 政治

[enums/BonusKind] enum
# @preset
1  | ATTR_LEADERSHIP | 武将统率
2  | ATTR_ATTACK     | 武将攻击
3  | ATTR_HEALTH     | 武将体力
4  | ATTR_SPEED      | 武将速度
5  | ATTR_DEFENSE    | 武将防御
6  | ATTR_INTELLECT  | 武将智力
7  | ATTR_CHARM      | 武将魅力
8  | ATTR_POLITICS   | 武将政治
20 | TROOP_ATTACK    | 部队攻击
21 | TROOP_DEFENSE   | 部队防御
22 | TROOP_HEALTH    | 部队生命
23 | MARCH_SPEED     | 行军速度
24 | TROOP_LOAD      | 部队负载
30 | RES_WOOD_RATE   | 木材产出加成
31 | RES_FOOD_RATE   | 粮食产出加成
32 | RES_IRON_RATE   | 铁矿产出加成
33 | STORAGE_CAP     | 仓库容量
40 | BUILD_SPEED     | 建造速度
41 | TRAIN_SPEED     | 训练速度
42 | RESEARCH_SPEED  | 研究速度

[enums/BuildingKind] enum
# @preset
1 | CORE       | 核心
2 | POPULATION | 人口
3 | WORKER     | 工人
4 | STORAGE    | 存储
5 | MILITARY   | 军事
6 | SCIENCE    | 科技
7 | SPECIAL    | 特殊
8 | DEFENSE    | 防御
9 | RESOURCE   | 资源

# ──────────────── Enum 段（续） ────────────────

[enums/SoldierKind] enum
# @preset
1  | SPEARMAN     | 长枪兵
2  | SWORDSHIELD  | 刀盾兵
3  | LIGHT_CAVALRY| 轻骑兵
4  | HEAVY_CAVALRY| 重骑兵
5  | CROSSBOW     | 连弩
6  | TREBUCHET    | 投石车
7  | BALLISTA     | 床弩
8  | THUNDER_TANK | 风雷战车
9  | PORTER       | 民夫
10 | BAGGAGE_CART | 辎重车
11 | SCOUT        | 斥候
12 | SETTLER      | 屯垦队
13 | RECYCLER     | 回收队
14 | CARAVAN      | 篷车

[enums/TechCategory] enum
# @preset
1 | BASIC    | 基础
2 | RECON    | 侦查
3 | MILITARY | 军事
4 | MOBILITY | 移动
5 | RANGED   | 远程
6 | SPECIAL  | 特殊

[enums/TerrainKind] enum
# @preset
1 | EMPTY    | 空地
2 | MOUNTAIN | 山地
3 | FOREST   | 林地
4 | PLAIN    | 平原
5 | CITY     | 城池

[enums/ResourceKind] enum
# @preset
1 | WOOD | 木材
2 | FOOD | 粮食
3 | IRON | 铁矿
4 | GOLD | 金币

[enums/DefenseKind] enum
# @preset
1 | TRAP        | 陷阱
2 | ABATIS      | 拒马
3 | ARROW_TOWER | 箭塔
4 | ROLLING_LOG | 滚木
5 | BOULDER     | 礌石
6 | CROSSBOW_PF | 弩台
7 | RAILING     | 护栏
8 | RAMPART     | 护墙

# ──────────────── Constant 段 ────────────────
# 全局常量：地图规格、城池上限、初始资源、保护期、关键武将引用等。

[global/GameConst] constant
# @preset
version              | str                     | 2.1.0                                     | cs | 文档版本
map_size             | int                     | 500                                       | cs | 大地图边长（格）
map_origin           | Tuple2<int,int>         | 0,0                                       | cs | 地图左上角坐标
map_max              | Tuple2<int,int>         | 499,499                                   | cs | 地图右下角坐标
empty_ratio          | float                   | 0.6                                       | cs | 空地占比
resource_ratio       | float                   | 0.35                                      | cs | 资源点占比
max_cities_per_user  | int                     | 9                                         | cs | 单玩家最大城池数
build_queue_default  | int                     | 2                                         | cs | 默认建筑队列
research_queue_default | int                   | 1                                         | cs | 默认研究队列
hero_total           | int                     | 450                                       | s  | 武将总规模
hero_attr_count      | int                     | 8                                         | s  | 武将属性数量
hero_skill_per_unit  | int                     | 6                                         | s  | 单武将技能数
tech_total           | int                     | 16                                        | s  | 科技总数
init_resources       | Map<int,int>            | 1:2000;2:2000;3:1000;4:500                | cs | 新手初始资源（key=@ResourceKind）
res_storage_caps     | Map<int,int>            | 1:10000;2:10000;3:8000                    | cs | 初始仓库上限（key=@ResourceKind）
soldier_food_cost    | Map<int,int>            | 1:1;3:3;5:2;6:5                           | s  | 兵种粮草消耗（key=@SoldierKind）
basic_attrs          | List<int>               | 1;2;3;4;5;6;7;8                           | cs | 武将八维属性（@HeroAttr id 列表）
factions             | List<int>               | 1;2;3                                     | cs | 主要势力（@Faction id 列表）
newbie_protect_hours | int                     | 72                                        | cs | 新手保护期（小时）
peace_protect_hours  | int                     | 8                                         | cs | 战败和平保护期（小时）
target_fps           | int                     | 60                                        | -  | 客户端目标帧率
package_size_max_mb  | int                     | 50                                        | -  | 包体大小上限
default_lord_pos     | Tuple2<int,int>         | 250,250                                   | cs | 主公出生坐标
default_color        | Tuple3<int,int,int>     | 200,30,30                                 | cs | 默认旗帜颜色
view_quad            | Tuple4<int,int,int,int> | 0,0,500,500                               | cs | 默认视野矩形
default_lord_hero    | @Hero                   | 1001                                      | cs | 默认主公武将（曹操）
default_faction      | @Faction                | 1                                         | cs | 默认势力（魏）

# ──────────────── Table 段：武将 ────────────────

[hero/Hero] table
id      | int          | cs | 武将 ID
name    | str          | cs | 名称
faction | @Faction     | cs | 所属势力
quality | @HeroQuality | cs | 品质
ldr     | int          | s  | 统率
atk     | int          | s  | 攻击
hp      | int          | s  | 体力
spd     | int          | s  | 速度
def     | int          | s  | 防御
int_a   | int          | s  | 智力
chr     | int          | cs | 魅力
pol     | int          | s  | 政治
skills  | List<int>    | cs | 技能 ID 列表
desc    | txt          | cs | 简介
